---
import MockWindow from "./MockWindow.astro";
import Ring from "./Ring.astro";
import Icon from "../Icon.astro";

// Steam 채팅 창에 오는 게임 초대. 이름은 예시다.
---

<MockWindow title="Steam 친구 및 채팅" variant="steam" icon="user-multiple-02">
  <div class="chat">
    <p class="who"><span class="dot"></span>호스트 친구</p>
    <div class="card">
      <span class="thumb"><Icon name="game-controller-03" size={26} /></span>
      <div class="txt">
        <b>게임 초대</b>
        <span>Project Zomboid 에 초대했습니다</span>
      </div>
      <span class="accept">
        게임 참가
        <Ring note="수락" at="bottom" />
      </span>
    </div>
    <p class="hint">게임은 메인 메뉴 화면에 둔 상태</p>
  </div>
</MockWindow>

<style>
  .chat {
    padding: 22px 24px 26px;
    font-size: 13px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    color: #c7d5e0;
    font-weight: 700;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #90ba3c;
  }
  .card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border-radius: 4px;
    background: #2a3f5a;
  }
  .thumb {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 3px;
    background: #7a1f1a;
    color: #fff;
  }
  .txt {
    display: grid;
    line-height: 1.4;
  }
  .txt b {
    color: #fff;
  }
  .txt span {
    color: #9fb4c8;
    font-size: 12px;
  }
  .accept {
    position: relative;
    padding: 8px 14px;
    border-radius: 3px;
    background: linear-gradient(180deg, #75b022, #588a1b);
    color: #fff;
    font-weight: 700;
    white-space: nowrap;
  }
  .hint {
    margin-top: 52px;
    color: #7a8a99;
    font-size: 12px;
  }
</style>
