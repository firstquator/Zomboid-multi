---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import Keys from "../components/Keys.astro";
import KeyMap from "../components/KeyMap.astro";
import VehicleRadial from "../components/VehicleRadial.astro";
import Dashboard from "../components/Dashboard.astro";
import MechDiagram from "../components/MechDiagram.astro";
import SubNext from "../components/SubNext.astro";
import { base } from "../lib/base-url.mjs";
import { keyify } from "../lib/keytext.mjs";
import { site } from "../lib/site.mjs";
import { keybinds, keyGroups, essentials, inventoryMoves } from "../data/keys.mjs";
import {
  startSteps,
  alarm,
  fuelWays,
  powerCut,
  carStats,
  mechOpen,
  mechBooks,
  driveNotes,
  together,
  carTips,
} from "../data/vehicles.mjs";
import { controlTips, tipTopics } from "../data/tips.mjs";
import { cookFacts, cookSteps, recipes, bestDishes, heatSources, fuels, boilWater, foodStates, storage, cookSkill, cookXp, cookCrafts } from "../data/cooking.mjs";

const g = (p: string) => base(`guide/${p}.webp`);
// 요리 데이터의 그림: "item:이름" 은 아이템 아이콘, "cook:이름" 은 열원 그림
const ic = (ref: string) => (ref.startsWith("item:") ? base(`icons/item/${ref.slice(5)}.webp`) : g(`cook/${ref.slice(5)}`));
// 연비: 차 무게가 1000 에서 멀수록 기름을 더 쓴다(Vehicles.lua 의 |1000 − 무게| / 300 + 1).
const fuelUse = (m: number) => Math.abs(1000 - m) / 300 + 1;
const maxUse = Math.max(...carStats.map((c) => fuelUse(c.mass)));
const cars = [...carStats].sort((a, b) => fuelUse(a.mass) - fuelUse(b.mass));

// 큰 탭과 그 안의 작은 탭. 작은 탭 id 는 "큰 탭-이름" 이고 주소(#car-fuel)로 남는다.
const mainTabs = [
  { id: "keys", label: "단축키", sub: "키보드·마우스", icon: "keyboard" },
  { id: "car", label: "차량", sub: "타기부터 정비까지", icon: "steering" },
  { id: "cook", label: "요리", sub: "레시피·익히기·보관", icon: "dish-01" },
  { id: "life", label: "생활 꿀팁", sub: "전투·건강·기지", icon: "bulb" },
];
const subTabs = {
  keys: [
    { id: "keys-ess", label: "먼저 외울 8개" },
    { id: "keys-map", label: "키보드에서 찾기" },
    { id: "keys-list", label: "상황별 목록" },
    { id: "keys-mouse", label: "마우스·조작" },
  ],
  car: [
    { id: "car-start", label: "타기·시동" },
    { id: "car-menu", label: "메뉴·계기판" },
    { id: "car-fuel", label: "기름·차 고르기" },
    { id: "car-mech", label: "정비" },
    { id: "car-drive", label: "운전·같이 타기" },
  ],
  cook: [
    { id: "cook-basic", label: "기본·익히기" },
    { id: "cook-recipes", label: "레시피" },
    { id: "cook-best", label: "추천 요리" },
    { id: "cook-heat", label: "열원·물" },
    { id: "cook-store", label: "보관·기술·제작" },
  ],
};
// 작은 탭 순서. 단축키 끝은 차량으로, 차량 끝은 생활 꿀팁으로 이어진다.
const order = [...subTabs.keys, ...subTabs.car, ...subTabs.cook, { id: "life", label: "생활 꿀팁" }];
const nextSub = (id: string) => order[order.findIndex((o) => o.id === id) + 1] ?? null;
---

<Base title="플레이 팁" active="tips" description="단축키, 차량 사용법, 생활 꿀팁. 42.21 게임 파일로 확인한 내용과 게임 그림으로 쉽게 정리했습니다.">
  <PageHead
    kicker={`Build ${site.build} · 단축키 · 차량 · 생활`}
    title="플레이 팁"
    desc="처음 같이 하는 사람이 알면 편한 것만 모았습니다. 키와 수치는 게임 파일에서 확인했고, 그림은 게임 안의 것을 그대로 썼습니다."
    icon="bulb"
    seed={61}
  >
  </PageHead>

  <!-- 큰 탭. 주소는 #keys, #car-fuel 처럼 "큰 탭-작은 탭" 으로 남는다. -->
  <div class="tabbar" data-tabs>
    <div class="wrap tabbar-in" role="tablist" aria-label="플레이 팁 주제">
      {
        mainTabs.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={t.id} aria-selected={i === 0 ? "true" : "false"} data-tab={t.id}>
            <span class="tb-ic">
              <Icon name={t.icon} size={22} />
            </span>
            <span class="tb-t">
              <b>{t.label}</b>
              <small>{t.sub}</small>
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- ───────── 단축키 ───────── -->
  <section class="wrap sec" id="keys" role="tabpanel" aria-labelledby="tab-keys" data-panel="keys">
    <h2 class="display">단축키</h2>
    <p class="lede">게임 기본값입니다. 바꾸고 싶으면 <span class="ui">설정</span> → <span class="ui">키 설정</span>에서 바꿉니다. 이름은 키 설정 화면에 나오는 이름 그대로입니다.</p>

    <div class="subtabs" role="tablist" aria-label="단축키 보기">
      {
        subTabs.keys.map((s, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-sub={s.id}>
            {s.label}
          </button>
        ))
      }
    </div>

    <div class="subpanel" data-subpanel="keys-ess">
    <h3 class="sub">먼저 외울 8개</h3>
    <ol class="ess">
      {
        essentials.map((e, i) => (
          <li class="reveal" style={`--i:${i % 4}`}>
            <Keys keys={e.keys} combo={e.combo} size="lg" />
            <b>{e.title}</b>
            <span><Fragment set:html={keyify(e.text)} /></span>
          </li>
        ))
      }
    </ol>
    <SubNext next={nextSub("keys-ess")} />
    </div>

    <div class="subpanel" data-subpanel="keys-map" hidden>
    <h3 class="sub">키보드에서 찾기</h3>
    <KeyMap />
    <SubNext next={nextSub("keys-map")} />
    </div>

    <div class="subpanel" data-subpanel="keys-list" hidden>
    <h3 class="sub">상황별로 보기</h3>
    <div class="kg" data-kg>
      <div class="kg-tabs" role="tablist" aria-label="상황">
        {
          keyGroups.map((gr, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-kg-tab={gr.id} class={`g-${gr.id}`}>
              <Icon name={gr.icon} size={16} />
              {gr.label}
              <span class="mono">{keybinds.filter((b) => b.group === gr.id).length}</span>
            </button>
          ))
        }
      </div>
      {
        keyGroups.map((gr, i) => (
          <ul class={`kg-list g-${gr.id}`} role="tabpanel" data-kg-panel={gr.id} hidden={i !== 0}>
            {keybinds
              .filter((b) => b.group === gr.id)
              .map((b) => (
                <li>
                  <Keys keys={b.keys} alt={b.alt} range={b.range} />
                  <span class="kg-name">
                    <b>{b.name}</b>
                    {b.when && <span class="when">{b.when}</span>}
                    {b.mod && <span class="when mod">모드</span>}
                  </span>
                  {b.tip && <span class="kg-tip"><Fragment set:html={keyify(b.tip)} /></span>}
                </li>
              ))}
          </ul>
        ))
      }
    </div>
    <SubNext next={nextSub("keys-list")} />
    </div>

    <div class="subpanel two-col" data-subpanel="keys-mouse" hidden>
      <div>
        <h3 class="sub">소지품 창에서</h3>
        <ul class="moves">
          {
            inventoryMoves.map((m) => (
              <li>
                <Keys keys={m.keys} combo={m.combo} double={m.double} />
                <span>
                  <b>{m.title}</b>
                  <Fragment set:html={keyify(m.text)} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="sub">알아 두면 좋은 조작</h3>
        <ul class="moves">
          {
            controlTips.map((c) => (
              <li>
                <Keys keys={c.keys} range={c.range} />
                <span><Fragment set:html={keyify(c.text)} /></span>
              </li>
            ))
          }
        </ul>
        <div class="callout">
          <Icon name="keyboard" size={20} />
          <p>
            <b>키가 안 먹으면 한/영부터 확인</b>
            윈도우 입력기가 한글 상태면 캐릭터가 움직이지 않습니다. 영문으로 두고, 채팅할 때만 채팅창에서 <kbd>\</kbd> 로 한/영을 바꿉니다(한글 채팅 입력 개선 모드).
          </p>
        </div>
      </div>
      <SubNext next={nextSub("keys-mouse")} />
    </div>
  </section>

  <!-- ───────── 차량 ───────── -->
  <section class="wrap sec" id="car" role="tabpanel" aria-labelledby="tab-car" data-panel="car" hidden>
    <div class="sec-art">
      <div>
        <h2 class="display">차량</h2>
        <p class="lede">차는 짐을 많이 싣고 빨리 움직이게 해 주지만, 시끄럽고 기름이 듭니다. 타는 법부터 기름, 정비까지 순서대로 정리했습니다.</p>
      </div>
      <img class="spiffo" src={g("spiffo/spiffo_vehicle")} alt="" loading="lazy" />
    </div>

    <div class="subtabs" role="tablist" aria-label="차량 보기">
      {
        subTabs.car.map((s, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-sub={s.id}>
            <span class="st-num mono">{i + 1}</span>
            {s.label}
          </button>
        ))
      }
    </div>

    <div class="subpanel" data-subpanel="car-start">
    <h3 class="sub">타고 시동 걸기</h3>
    <ol class="steps">
      {
        startSteps.map((s, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <span class="tile big">
              <img src={g(s.icon)} alt="" loading="lazy" />
            </span>
            <span class="st-n mono">{i + 1}</span>
            <b>{s.title}</b>
            {s.keys && <Keys keys={s.keys} />}
            <p><Fragment set:html={keyify(s.text)} /></p>
            <p class="st-note"><Fragment set:html={keyify(s.note)} /></p>
          </li>
        ))
      }
    </ol>
    <div class="callout warn">
      <Icon name="alert-02" size={20} />
      <p>
        <b>{alarm.title}</b>
        <Fragment set:html={keyify(alarm.text)} />
      </p>
    </div>
    <SubNext next={nextSub("car-start")} />
    </div>

    <div class="subpanel" data-subpanel="car-menu" hidden>
    <div class="split">
      <div>
        <h3 class="sub">차량 메뉴 <kbd>V</kbd></h3>
        <p class="sub-lede">차 안과 차 밖에서 뜨는 메뉴가 다릅니다. 시동, 문 잠그기, 주유, 정비처럼 차로 하는 일은 대부분 여기 있습니다. 아이콘을 눌러 보세요.</p>
        <figure class="real">
          <img src={g("vehicle/carradialmenu")} alt="게임 안내서에 실린 차량 원형 메뉴 그림" width="250" height="249" loading="lazy" />
          <figcaption>게임 안내서에 실린 실제 메뉴 그림</figcaption>
        </figure>
      </div>
      <VehicleRadial />
    </div>

    <h3 class="sub">계기판 읽기</h3>
    <p class="sub-lede">운전석에 앉으면 화면 아래에 계기판이 뜹니다. 번호를 누르거나 설명에 마우스를 올려 보세요.</p>
    <Dashboard />
    <SubNext next={nextSub("car-menu")} />
    </div>

    <div class="subpanel" data-subpanel="car-fuel" hidden>
    <h3 class="sub">기름 넣기</h3>
    <div class="fuel">
      {
        fuelWays.map((f) => (
          <article class="card reveal">
            <div class="icons">
              {f.icons.map((ic) => (
                <span class="tile">
                  <img src={g(ic)} alt="" loading="lazy" />
                </span>
              ))}
            </div>
            <b>{f.title}</b>
            <span class="menu-chip">V → {f.menu}</span>
            <p><Fragment set:html={keyify(f.text)} /></p>
          </article>
        ))
      }
      <article class="card dark reveal">
        <div class="icons">
          {
            powerCut.icons.map((ic) => (
              <span class="tile">
                <img src={g(ic)} alt="" loading="lazy" />
              </span>
            ))
          }
        </div>
        <b>{powerCut.title}</b>
        <p><Fragment set:html={keyify(powerCut.text)} /></p>
      </article>
    </div>

    <div class="cars reveal">
      <p class="cars-title"><Icon name="analytics-01" size={18} />어떤 차가 좋을까</p>
      <table>
        <thead>
          <tr>
            <th scope="col">차</th>
            <th scope="col">기름 쓰는 양 <small>짧을수록 좋음</small></th>
            <th scope="col">트렁크</th>
            <th scope="col">엔진 소리</th>
          </tr>
        </thead>
        <tbody>
          {
            cars.map((c) => (
              <tr>
                <th scope="row">
                  {c.name}
                  {c.note && <small>{c.note}</small>}
                </th>
                <td>
                  <span class="bar">
                    <i style={`width:${(fuelUse(c.mass) / maxUse) * 100}%`} />
                  </span>
                </td>
                <td class="mono">{c.trunk ?? "–"}</td>
                <td class="mono">{c.loud ?? "–"}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="cars-foot">차 무게가 1000에 가까울수록 기름을 덜 씁니다(게임 계산식). 엔진 품질이 낮거나 히터를 켜면 더 씁니다. 트렁크와 소리는 차 파일 값입니다.</p>
    </div>
    <SubNext next={nextSub("car-fuel")} />
    </div>

    <div class="subpanel" data-subpanel="car-mech" hidden>
    <h3 class="sub">정비</h3>
    <p class="sub-lede">
      정비 화면은
      {
        mechOpen.map((m, i) => (
          <>
            {i > 0 && ", "}
            <span class="nowrap"><Fragment set:html={keyify(m.text)} /></span>
          </>
        ))
      }
      로 엽니다. 부품을 우클릭해서 장착·분리·수리를 고릅니다.
    </p>
    <MechDiagram />
    <div class="books">
      <p class="books-title">대형·스포츠 차는 정비 지식이 따로 필요합니다</p>
      <ul>
        {
          mechBooks.map((b) => (
            <li>
              <span class="tile">
                <img src={g(b.icon)} alt="" loading="lazy" />
              </span>
              <span>
                <b>{b.type}</b>
                <span class="bk-name">잡지: {b.name}</span>
                <small>{b.cars}</small>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="books-foot">자동차 정비공 직업은 셋 다 알고 시작합니다. 차량정비 8·9·10레벨에 차례로 저절로 배웁니다.</p>
    </div>
    <SubNext next={nextSub("car-mech")} />
    </div>

    <div class="subpanel" data-subpanel="car-drive" hidden>
    <h3 class="sub">운전할 때</h3>
    <ul class="notes-grid">
      {
        driveNotes.map((d, i) => (
          <li class="reveal" style={`--i:${i % 3}`}>
            <span class="tile">
              <img src={g(d.icon)} alt="" loading="lazy" />
            </span>
            <span>
              <b>{d.title}</b>
              <Fragment set:html={keyify(d.text)} />
            </span>
          </li>
        ))
      }
    </ul>

    <div class="two-col">
      <div>
        <h3 class="sub">같이 탈 때</h3>
        <ul class="checks">
          {together.map((t) => <li><Fragment set:html={keyify(t)} /></li>)}
        </ul>
      </div>
      <div>
        <h3 class="sub">커뮤니티 꿀팁</h3>
        <ul class="checks src">
          {
            carTips.map((t) => (
              <li>
                <Fragment set:html={keyify(t.text)} />
                <small>
                  {t.url ? (
                    <a href={t.url} target="_blank" rel="noopener noreferrer">
                      {t.src}
                    </a>
                  ) : (
                    t.src
                  )}
                </small>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <SubNext next={nextSub("car-drive")} />
    </div>
  </section>

  <!-- ───────── 요리 ───────── -->
  <section class="wrap sec" id="cook" role="tabpanel" aria-labelledby="tab-cook" data-panel="cook" hidden>
    <div class="sec-art">
      <div>
        <h2 class="display">요리</h2>
        <p class="lede">B42 요리는 냄비·그릇·빵 같은 바탕에 재료를 하나씩 넣어 만듭니다. 익히면 더 든든하고, 여러 재료를 넣으면 기분도 좋아집니다.</p>
      </div>
      <img class="spiffo" src={g("spiffo/spiffo_food")} alt="" loading="lazy" />
    </div>

    <div class="subtabs" role="tablist" aria-label="요리 보기">
      {
        subTabs.cook.map((s, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-sub={s.id}>
            <span class="st-num mono">{i + 1}</span>
            {s.label}
          </button>
        ))
      }
    </div>

    <div class="subpanel" data-subpanel="cook-basic">
      <h3 class="sub">먼저 알 것</h3>
      <ul class="facts">
        {
          cookFacts.map((f, i) => (
            <li class="reveal" style={`--i:${i % 3}`}>
              <span class="tile big"><img src={ic(f.icon)} alt="" loading="lazy" /></span>
              <span>
                <b>{f.title}</b>
                <Fragment set:html={keyify(f.text)} />
              </span>
            </li>
          ))
        }
      </ul>
      <h3 class="sub">익히는 순서</h3>
      <ol class="flow">
        {
          cookSteps.map((s, i) => (
            <li>
              <span class="tile big"><img src={ic(s.icon)} alt="" loading="lazy" /></span>
              <span class="fl-n mono">{i + 1}</span>
              <b>{s.title}</b>
              <p set:html={keyify(s.text)} />
            </li>
          ))
        }
      </ol>
      <SubNext next={nextSub("cook-basic")} />
    </div>

    <div class="subpanel" data-subpanel="cook-recipes" hidden>
      <h3 class="sub">레시피 <small class="sub-note">바탕 + 재료 → 요리</small></h3>
      <p class="sub-lede">바탕을 우클릭하면 메뉴가 뜹니다. 재료는 가방이나 주변 상자에 있어야 목록에 나옵니다. 처음 넣은 뒤에는 만들어진 요리를 다시 우클릭해서 「재료 추가하기」로 더 넣습니다.</p>
      <ul class="recipes">
        {
          recipes.map((r) => (
            <li>
              <div class="eqn">
                <span class="tile big"><img src={ic(r.base.icon)} alt="" loading="lazy" /></span>
                <span class="op">+</span>
                <span class="ing-stack">
                  {r.ings.slice(0, 3).map((x) => (
                    <span class="tile sm"><img src={ic(x.icon)} alt="" loading="lazy" /></span>
                  ))}
                </span>
                <span class="op">→</span>
                <span class="tile big res"><img src={ic(r.result)} alt="" loading="lazy" /></span>
              </div>
              <div class="rc-head">
                <b>{r.name}</b>
                {r.cook ? <span class="pill fire">익혀야 함 · {r.cook}분</span> : r.warm ? <span class="pill">불 없이 · 데우면 더 좋음</span> : <span class="pill cold">불 없이</span>}
              </div>
