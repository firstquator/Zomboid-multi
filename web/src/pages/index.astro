---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import RoleFolder from "../components/RoleFolder.astro";
import Terminal from "../components/Terminal.astro";
import CopyButton from "../components/CopyButton.astro";
import ModTag from "../components/ModTag.astro";
import Icon from "../components/Icon.astro";
import Topo from "../components/Topo.astro";
import { base } from "../lib/base-url.mjs";
import { site, mods, INSTALL_COMMAND, INSTALL_URL, SERVER_NAME } from "../lib/site.mjs";
import { demoLines } from "../lib/installer.mjs";
import { hostSteps, joinSteps } from "../data/guides.mjs";

const lines = demoLines({ modCount: site.modCount, serverName: SERVER_NAME });

// 전체 흐름 세 단계. 누가 하는지와 어디서 하는지를 함께 보여 준다.
const flow = [
  {
    n: "01",
    who: "모두",
    icon: "game-controller-03",
    title: "게임 버전 확인",
    desc: `Steam 속성 → 게임 버전 및 베타 → <span class="ui">Default Public Version</span>. 게임 첫 화면 버전이 <code>${site.build}</code>인지 확인합니다.`,
  },
  {
    n: "02",
    who: "호스트",
    icon: "server-stack-01",
    title: "서버 열기",
    desc: `설치 명령 한 줄 → <span class="ui">서버 만들기</span> → <code>${SERVER_NAME}</code> → <span class="ui">시작</span> → <kbd>Esc</kbd> → <span class="ui">친구 초대</span>`,
    href: base("guide/#host-0"),
    cta: "호스트 가이드",
  },
  {
    n: "03",
    who: "참가자",
    icon: "user-group",
    title: "초대 수락",
    desc: `메인 메뉴에서 Steam 초대 <span class="ui">게임 참가</span> → 창작마당 아이템 <span class="ui">설치</span>. 모드는 자동으로 받습니다.`,
    href: base("guide/#join-0"),
    cta: "참가자 가이드",
  },
];
---

<Base title="좀보이드 멀티" active="home">
  <Hero />

  <section class="flow wrap" aria-labelledby="flow-title">
    <header class="sec-head reveal">
      <p class="kicker">01</p>
      <h2 id="flow-title" class="display">진행 순서</h2>
    </header>
    <ol class="flow-list">
      {
        flow.map((f, i) => (
          <li class="flow-item reveal" style={`--i:${i}`}>
            <span class="flow-n mono">{f.n}</span>
            <span class="flow-ic">
              <Icon name={f.icon} size={24} />
            </span>
            <span class="flow-who">{f.who}</span>
            <h3>{f.title}</h3>
            <p set:html={f.desc} />
            {f.href && (
              <a class="flow-link" href={f.href}>
                {f.cta}
                <Icon name="arrow-right-02" size={18} />
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="roles wrap" aria-labelledby="roles-title">
    <header class="sec-head reveal">
      <p class="kicker">02</p>
      <h2 id="roles-title" class="display">가이드</h2>
      <p class="sec-lede">단계별 슬라이드입니다. 키보드 <kbd>←</kbd> <kbd>→</kbd> 로 넘길 수 있습니다.</p>
    </header>

    <div class="folders">
      <RoleFolder
        tab="HOST"
        icon="server-stack-01"
        title="호스트 가이드"
        desc="자기 PC에서 서버를 여는 1명. 설치 명령, 서버 만들기, 방화벽, 친구 초대까지 다룹니다."
        minutes={hostSteps.minutes}
        steps={hostSteps.titles.length - 2}
        href={base("guide/#host-0")}
        cta="호스트 가이드 열기"
        sheet={hostSteps.titles.slice(1, -1)}
        tone="red"
        index={0}
      />
      <RoleFolder
        tab="PLAYER"
        icon="user-group"
        title="참가자 가이드"
        desc="호스트 서버에 접속하는 나머지 전원. 버전 확인, 언어 설정, 초대 수락, 모드 설치를 다룹니다."
        minutes={joinSteps.minutes}
        steps={joinSteps.titles.length - 2}
        href={base("guide/#join-0")}
        cta="참가자 가이드 열기"
        sheet={joinSteps.titles.slice(1, -1)}
        index={1}
      />
    </div>

    <a class="char-link reveal" href={base("character/")}>
      <span class="cl-ic"><Icon name="user-circle" size={26} /></span>
      <span class="cl-text">
        <b>캐릭터 만들기</b>
        직업과 특성 고르는 법, 역할별 추천 조합, 포인트 계산기
      </span>
      <Icon name="arrow-right-02" size={20} />
    </a>
  </section>

  <section class="install" id="install" aria-labelledby="install-title">
    <Topo seed={11} hills={3} levels={10} class="install-topo" />
    <div class="wrap install-grid">
      <div class="install-copy reveal">
        <p class="kicker night">03 · 호스트용</p>
        <h2 id="install-title" class="display">설치 명령</h2>
        <p class="sec-lede">
          모드 {site.modCount}개가 등록된 서버 설정 <b>{SERVER_NAME}</b>을 게임 폴더에 만듭니다.
          설치 후 게임에서 서버 만들기 → <b>{SERVER_NAME}</b> → 시작 순서로 서버를 엽니다.
        </p>

        <ul class="facts">
          <li>
            <span class="f-ic"><Icon name="folder-open" size={20} /></span>
            <span><b>쓰는 위치</b><code>%USERPROFILE%\Zomboid\Server</code> 안의 설정 파일 4개만 다룹니다.</span>
          </li>
          <li>
            <span class="f-ic"><Icon name="archive" size={20} /></span>
            <span><b>기존 파일</b>날짜를 붙여 백업하고, 모드 목록과 미니맵 같은 필요한 값만 바꿉니다.</span>
          </li>
          <li>
            <span class="f-ic"><Icon name="eye" size={20} /></span>
            <span><b>원문 공개</b>실행 전에 <a href={INSTALL_URL} target="_blank" rel="noopener">스크립트 원문</a>을 확인할 수 있습니다.</span>
          </li>
        </ul>
      </div>

      <div class="install-demo reveal" style="--i:1">
        <Terminal command={INSTALL_COMMAND} lines={lines} />
        <div class="cmdline" data-copy-scope>
          <code data-copy-text>{INSTALL_COMMAND}</code>
          <CopyButton value={INSTALL_COMMAND} label="명령어 복사" tone="night" size="lg" />
        </div>
        <p class="how">
          <Icon name="keyboard" size={16} />
          <span><kbd>Win</kbd> → <b>powershell</b> 입력 → <kbd>Enter</kbd> → <kbd>Ctrl</kbd>+<kbd>V</kbd> → <kbd>Enter</kbd></span>
        </p>
      </div>
    </div>
  </section>

  <section class="pack wrap" aria-labelledby="pack-title">
    <header class="sec-head reveal">
      <p class="kicker">04 · 모드팩 {site.modpackVersion}</p>
      <h2 id="pack-title" class="display">모드 목록</h2>
      <p class="sec-lede">
        편의 기능 위주로 골랐습니다. 모두 Build {site.build}에서 동작을 확인했고, 필요한 라이브러리까지 포함했습니다.
      </p>
    </header>
    <div class="tags">
      {mods.map((m, i) => <ModTag mod={m} index={i} />)}
    </div>
    <p class="pack-more reveal">
      <a class="btn btn-ghost" href={base("mods/")}>
        <Icon name="package" size={20} />
        <span>모드별 설명과 ID 보기</span>
        <Icon name="arrow-right-02" size={20} />
      </a>
    </p>
  </section>

  {
    site.changes.length > 0 && (
      <section class="log wrap" aria-labelledby="log-title">
        <header class="sec-head reveal">
          <p class="kicker">05</p>
          <h2 id="log-title" class="display">변경 기록</h2>
        </header>
        <ol class="entries">
          {site.changes.map((c, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <time class="mono" datetime={c.date}>{c.date}</time>
              <p>{c.summary}</p>
              {c.mustUpdate && (
                <span class="must">
                  <Icon name="refresh" size={14} />
                  호스트는 설치 명령을 다시 실행하세요
                </span>
              )}
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  .sec-head {
    display: grid;
    gap: 12px;
    margin-bottom: 44px;
  }
  .sec-head h2,
  .install h2 {
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.1;
  }
  .sec-lede {
    max-width: 52em;
    font-size: clamp(16px, 1.25vw, 18px);
    color: var(--ink-2);
  }

  .flow {
    padding-top: 110px;
  }
  .flow-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  /* 세 카드를 잇는 점선. 순서가 있다는 것을 말 없이 보여 준다. */
  .flow-list::before {
    content: "";
    position: absolute;
    left: 8%;
    right: 8%;
    top: 52px;
    border-top: 2px dashed var(--rule-strong);
    z-index: -1;
  }
  .flow-item {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 26px 24px 24px;
    background: var(--paper-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sheet);
    transition:
      transform 250ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 250ms ease;
  }
  .flow-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
  .flow-n {
    position: absolute;
    top: 18px;
    right: 22px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .flow-ic {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--ink);
    color: var(--paper-3);
  }
  .flow-item:nth-child(2) .flow-ic {
    background: var(--red);
    color: #fff7ea;
  }
  .flow-who {
    width: fit-content;
    margin-top: 8px;
    padding: 1px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--ink-2);
    font-size: 12.5px;
    font-weight: 600;
  }
  .flow-item h3 {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 26px;
  }
  .flow-item p {
    color: var(--ink-2);
    font-size: 15px;
  }
  .flow-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    margin-top: 6px;
    color: var(--red);
    font-weight: 700;
    text-decoration: none;
  }
  .flow-link:hover :global(.icon) {
    transform: translateX(3px);
  }
  .flow-link :global(.icon) {
    transition: transform 200ms ease;
  }

  .roles {
    padding-top: 120px;
  }
  .folders {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
  }

  .char-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
    padding: 18px 22px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-3);
    color: var(--ink-2);
    text-decoration: none;
    box-shadow: var(--shadow-sheet);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }
  .char-link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }
  .cl-ic {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--night);
    color: var(--sodium);
  }
  .cl-text b {
    display: block;
    color: var(--ink);
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 22px;
  }

  .install {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 130px;
    padding-block: clamp(72px, 9vw, 120px);
    background:
      radial-gradient(70% 60% at 85% 20%, rgb(240 169 58 / 0.12), transparent 70%),
      var(--night);
    color: var(--night-ink);
  }
  .install :global(.install-topo) {
    z-index: -1;
    color: var(--sodium);
    opacity: 0.07;
  }
  .install-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  .kicker.night {
    color: var(--sodium);
  }
  .install h2 {
    margin-top: 12px;
    color: #f4ecd5;
  }
  .install .sec-lede {
    margin-top: 20px;
    color: #c4bba1;
  }
  .install .sec-lede b {
    color: var(--sodium);
    font-family: var(--f-mono);
    font-weight: 500;
  }
  .facts {
    display: grid;
    gap: 18px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    font-size: 15px;
    color: #b7ae94;
  }
  .facts b {
    display: block;
    color: var(--night-ink);
    margin-bottom: 2px;
  }
  .facts a {
    color: var(--sodium);
  }
  .facts code {
    color: var(--night-ink);
  }
  .f-ic {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgb(240 169 58 / 0.12);
    border: 1px solid rgb(240 169 58 / 0.3);
    color: var(--sodium);
  }
  .install-demo {
    display: grid;
    gap: 18px;
  }
  .install-demo :global(.cmdline) {
    box-shadow: 5px 5px 0 #000;
    border-color: #000;
  }
  .how {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: #a59d86;
  }
  .how kbd {
    background: #22231c;
    color: var(--night-ink);
    border-color: #4a4a3c;
  }
  .how b {
    color: var(--night-ink);
    font-family: var(--f-mono);
    font-weight: 500;
  }

  .pack {
    padding-top: 130px;
  }
  .tags {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 30px 24px;
  }
  .pack-more {
    display: flex;
    justify-content: center;
    margin-top: 52px;
  }

  .log {
    padding-top: 110px;
  }
  .entries {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 2px solid var(--rule);
  }
  .entries li {
    position: relative;
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 6px 24px;
    padding: 16px 0 16px 28px;
  }
  .entries li::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 24px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--paper);
    border: 3px solid var(--red);
  }
  .entries time {
    color: var(--red);
    font-weight: 600;
    padding-top: 2px;
  }
  .entries p {
    color: var(--ink-2);
  }
  .must {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    padding: 2px 9px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--red) 10%, transparent);
    color: var(--red);
    font-size: 13px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .flow-list,
    .folders,
    .install-grid {
      grid-template-columns: 1fr;
    }
    .flow-list::before {
      display: none;
    }
    .entries li {
      grid-template-columns: 1fr;
    }
    .must {
      grid-column: 1;
    }
  }
</style>
