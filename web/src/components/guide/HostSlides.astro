---
// 호스트 가이드 슬라이드. pages/guide.astro 가 Deck 안에 넣는다.
import Slide from "../Slide.astro";
import Icon from "../Icon.astro";
import Shot from "../Shot.astro";
import Terminal from "../Terminal.astro";
import CopyButton from "../CopyButton.astro";
import MockSteamBeta from "../mock/MockSteamBeta.astro";
import MockPZMenu from "../mock/MockPZMenu.astro";
import MockPZHost from "../mock/MockPZHost.astro";
import MockFirewall from "../mock/MockFirewall.astro";
import MockInvite from "../mock/MockInvite.astro";
import MockSettings from "../mock/MockSettings.astro";
import StepIndex from "../StepIndex.astro";
import Menu from "../Menu.astro";
import { base } from "../../lib/base-url.mjs";
import { site, vanilla, INSTALL_COMMAND, SERVER_NAME } from "../../lib/site.mjs";
import { demoLines } from "../../lib/installer.mjs";
import { hostSteps } from "../../data/guides.mjs";

const T = hostSteps.titles;
const N = T.length - 2;
const lines = demoLines({ modCount: site.modCount, serverName: SERVER_NAME });
const index = [
  { icon: "game-controller-03", note: "Steam 속성 → 게임 버전 및 베타 → Default Public Version" },
  { icon: "translate", note: "약관 동의, 언어 한국어" },
  { icon: "command-line", note: "PowerShell 명령 한 줄" },
  { icon: "server-stack-01", note: "메인 메뉴" },
  { icon: "settings-02", note: "미니맵 · 지도 플레이어 표시 · 독서 시간" },
  { icon: "play-circle", note: `${SERVER_NAME} · 메모리 5~8GB` },
  { icon: "shield-01", note: "처음 한 번, 액세스 허용" },
  { icon: "user-add-01", note: "Esc → 친구 초대 → 초대" },
].map((s, i) => ({ ...s, title: T[i + 1] }));
---

<Slide n={0} total={N} title={T[0]} tone="cover" kicker="서버를 여는 1명">
  <p class="lede">
    게임 메뉴의 <b>서버 만들기</b>로 자기 PC에서 서버를 열고, Steam으로 친구를 초대합니다.
    포트포워딩이나 별도 서버 프로그램은 필요 없습니다.
  </p>
  <ul class="need">
    <li><Icon name="game-controller-03" size={22} /><span>Project Zomboid<small>Steam 정품, Build {site.build}</small></span></li>
    <li><Icon name="windows-new" size={22} /><span>Windows 10 / 11<small>PowerShell 기본 포함</small></span></li>
    <li><Icon name="cpu" size={22} /><span>메모리 16GB 이상 권장<small>게임 3GB + 서버 5~8GB</small></span></li>
    <li><Icon name="user-multiple-02" size={22} /><span>참가자와 Steam 친구<small>초대는 Steam으로 보냄</small></span></li>
  </ul>
  <p>
    <button type="button" class="btn btn-red" data-goto="1">
      <span>1단계부터 보기</span>
      <Icon name="arrow-right-02" size={20} />
    </button>
  </p>
  <StepIndex slot="visual" title="진행 순서" steps={index} />
</Slide>

<Slide n={1} total={N} title={T[1]} kicker="호스트와 참가자 모두 같은 버전">
  <ol class="do">
    <li><Menu app="Steam" path={["라이브러리", "Project Zomboid 우클릭", "속성"]} /></li>
    <li><Menu path={["게임 버전 및 베타", "Default Public Version"]} /> <span class="sub">베타를 고르지 않은 기본 상태. 예전 Steam 에서는 "없음"</span></li>
    <li>업데이트가 있으면 <b>완료될 때까지 대기</b></li>
  </ol>
  <div class="success">
    <Icon name="checkmark-circle-02" size={20} />
    <span><b>확인:</b> 게임 첫 화면 구석의 버전 표기가 <code>{site.build}</code></span>
  </div>
  <div class="callout warn">
    <Icon name="alert-02" size={20} />
    <span><b>unstable · legacy41 · 42.19 선택 금지</b>버전이 하나라도 다르면 <b>접속할 수 없습니다</b>.</span>
  </div>
  <Shot id="steam-beta" slot="visual" labels={["게임 버전 및 베타", "Default Public Version"]}><MockSteamBeta /></Shot>
</Slide>

<Slide n={2} total={N} title={T[2]} kicker="약관 동의와 언어">
  <ol class="do">
    <li>게임 실행 → 첫 실행이면 <b>약관 동의</b></li>
    <li><Menu path={["설정", "사용자 인터페이스 (UI)", "언어 선택", "한국어"]} /> <span class="sub">한국어 Windows는 처음부터 한국어로 표시</span></li>
    <li><b>게임 종료</b></li>
  </ol>
  <div class="callout warn">
    <Icon name="alert-02" size={20} />
    <span><b>다음 단계는 게임을 끈 상태에서</b>게임이 켜져 있으면 설치 명령이 <b>아무것도 쓰지 않고 멈춥니다</b>.</span>
  </div>
  <Shot id="pz-language" slot="visual" labels={["사용자 인터페이스 (UI)", "Language → 한국어", "ACCEPT"]}><MockPZMenu highlight="options" note="설정 → UI → 언어 선택" /></Shot>
</Slide>

<Slide n={3} total={N} title={T[3]} kicker="PowerShell 명령 한 줄">
  <ol class="do">
    <li><kbd>Win</kbd> 누르고 <code>powershell</code> 입력 → <kbd>Enter</kbd></li>
    <li>아래 명령 <span class="ui">복사</span> → PowerShell 창에 <kbd>Ctrl</kbd>+<kbd>V</kbd> → <kbd>Enter</kbd></li>
    <li>초록색 <b>설치 완료</b>가 나오면 창을 닫아도 됩니다</li>
  </ol>
  <div class="cmdline" data-copy-scope>
    <code data-copy-text>{INSTALL_COMMAND}</code>
    <CopyButton value={INSTALL_COMMAND} label="복사" tone="night" />
  </div>
  <details class="more">
    <summary><Icon name="eye" size={16} />명령이 하는 일</summary>
    <div>
      <p>
        <code>Zomboid\Server</code>에 <code>{SERVER_NAME}</code> 설정 파일 4개를 만듭니다.
        서버 설정(모드 {site.modCount}개 등록), 샌드박스(미니맵 켜기), 스폰 지역 11곳, 스폰 지점입니다.
      </p>
      <p>
        이미 파일이 있으면 날짜를 붙여 백업하고, 모드 목록과 미니맵 같은 필요한 값만 바꿉니다.
        게임 안에서 바꾼 다른 설정은 그대로 남습니다.
      </p>
      <p><a href={base("install.ps1")} target="_blank" rel="noopener">스크립트 원문 보기</a> · <a href={base("mods/#manual")}>수동 설정</a></p>
    </div>
  </details>
  <Terminal slot="visual" command={INSTALL_COMMAND} lines={lines} />
</Slide>

<Slide n={4} total={N} title={T[4]} kicker="메인 메뉴">
  <ol class="do">
    <li>게임 실행</li>
    <li><Menu path={["메인 메뉴", "서버 만들기"]} /> <span class="sub">영문 화면에서는 HOST</span></li>
  </ol>
  <div class="callout tip">
    <Icon name="information-circle" size={20} />
    <span><b>서버는 게임이 함께 실행</b>호스트가 게임을 끄면 서버도 <b>저장 후 종료</b>됩니다.</span>
  </div>
  <Shot id="pz-main-menu" slot="visual" pick={[0]} labels={["서버 만들기 (HOST)"]}><MockPZMenu highlight="host" note="서버 만들기" /></Shot>
</Slide>

<Slide n={5} total={N} title={T[5]} kicker="선택 · 그대로 시작해도 됩니다">
  <p>설치 명령이 아래 값을 미리 넣어 두었습니다. 바꾸고 싶을 때만 따라 하세요.</p>
  <ol class="do">
    <li><span class="ui">서버 이름 :</span> <code>{SERVER_NAME}</code> 선택 → <span class="ui">서버 설정</span></li>
    <li><Menu path={["서버 설정 관리", SERVER_NAME, "선택한 서버 설정 수정하기"]} /></li>
    <li>아래 위치에서 값 변경 → <span class="ui">저장</span></li>
  </ol>
  <ul class="setlist">
    {
      vanilla.map((v: any) => (
        <li>
          <b>{v.feature}</b>
          <span class="sv mono">{v.value}</span>
          <span class="sw">{v.where}</span>
        </li>
      ))
    }
  </ul>
  <Shot
    id="pz-server-settings"
    slot="visual"
    targets={[
      { x: 1.2, y: 21.0, w: 22.5, h: 2.8, label: "플레이어 설정 · 지도 표시" },
      { x: 1.2, y: 87.0, w: 22.5, h: 2.8, label: "샌드박스 → 캐릭터 설정" },
      { x: 64.6, y: 92.6, w: 15.6, h: 2.6, label: "독서 시간 2.0 → 0.1" },
    ]}
  ><MockSettings /></Shot>
</Slide>

<Slide n={6} total={N} title={T[6]} kicker="서버 열기 화면">
  <ol class="do">
    <li><span class="ui">서버 이름 :</span> <code>{SERVER_NAME}</code></li>
    <li><span class="ui">서버 메모리 설정 :</span> 4명 기준 <code>5 GB</code>, 그 이상이면 <code>6~8 GB</code></li>
    <li><span class="ui">시작</span> → 창작마당 아이템 다운로드 완료까지 대기 <span class="sub">처음 한 번, 몇 분</span></li>
    <li>캐릭터 생성 후 게임에 들어가면 <b>서버가 열린 상태</b></li>
  </ol>
  <div class="callout warn">
    <Icon name="alert-02" size={20} />
    <span><b>목록에 {SERVER_NAME}이 없을 때</b>3단계 명령이 <b>설치 완료</b>로 끝났는지 확인합니다. <a href={base("help/#no-preset")}>자세히</a></span>
  </div>
  <Shot id="pz-host-screen" slot="visual" pick={[0, 2, 3]} labels={[`서버 이름: ${SERVER_NAME}`, "메모리 5~8 GB", "시작 (START)"]}><MockPZHost /></Shot>
</Slide>

<Slide n={7} total={N} title={T[7]} kicker="처음 한 번">
  <p>서버를 처음 열면 Windows 방화벽 확인 창이 뜹니다. 서버 프로그램 이름은 <code>Zulu Platform x64 Architecture</code>로 보일 수 있습니다.</p>
  <ol class="do">
    <li><b>개인 네트워크</b> 체크 확인</li>
    <li><span class="ui">액세스 허용</span></li>
  </ol>
  <div class="callout warn">
    <Icon name="shield-01" size={20} />
    <span><b>취소를 눌렀다면</b>참가자가 접속하지 못할 수 있습니다. <a href={base("help/#firewall")}>다시 허용하는 방법</a></span>
  </div>
  <Shot id="win-firewall" slot="visual" labels={["개인 네트워크 체크", "액세스 허용"]}><MockFirewall /></Shot>
</Slide>

<Slide n={8} total={N} title={T[8]} kicker="매번 서버를 열 때마다">
  <ol class="do">
    <li>게임 안에서 <kbd>Esc</kbd> → <Menu path={["친구 초대"]} /></li>
    <li>목록에서 친구를 골라 <span class="ui">초대</span> <span class="sub">친구마다 반복</span></li>
    <li>참가자는 게임을 켜고 <b>메인 메뉴</b>에서 초대를 수락합니다</li>
  </ol>
  <div class="callout warn">
    <Icon name="alert-02" size={20} />
    <span><b>초대한 사람만 접속 가능</b>서버 만들기로 연 서버는 호스트가 초대하거나 수락한 Steam 계정만 받습니다. <b>서버를 다시 열 때마다</b> 초대합니다.</span>
  </div>
  <div class="callout tip">
    <Icon name="information-circle" size={20} />
    <span><b>참가자가 게임 중이면 초대를 받지 못함</b>메인 메뉴로 나온 상태에서 다시 초대합니다.</span>
  </div>
  <div class="visual-stack" slot="visual">
    <Shot id="pz-esc-invite" labels={["친구 초대 (INVITE FRIENDS)"]} />
    <Shot id="pz-invite-friends" labels={["친구 선택", "초대 (INVITE)"]}><MockInvite /></Shot>
  </div>
</Slide>

<Slide n={N + 1} total={N} title={T[N + 1]} tone="done" kicker="서버 운영">
  <span class="done-mark" aria-hidden="true"><Icon name="tick-02" size={44} /></span>
  <ul class="need">
    <li><Icon name="stop-circle" size={22} /><span>서버 종료<small>호스트가 마지막에 나가기. 나가면 저장 후 종료</small></span></li>
    <li><Icon name="archive" size={22} /><span>자동 백업<small>서버를 켤 때마다 <code>Zomboid\backups\startup</code>에 5개까지</small></span></li>
    <li><Icon name="refresh" size={22} /><span>모드팩 업데이트<small>게임을 끄고 3단계 명령만 다시 실행</small></span></li>
    <li><Icon name="user-add-01" size={22} /><span>다음 접속<small>서버 만들기 → 시작 → 친구 초대</small></span></li>
  </ul>
  <p>
    <a class="btn" href={base("help/")}>
      <Icon name="first-aid-kit" size={20} />
      <span>문제 해결</span>
    </a>
  </p>
</Slide>

<style>
  .lede {
    font-size: clamp(17px, 1.5vw, 19px);
    color: var(--ink-2);
    max-width: 32em;
  }
  .setlist {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .setlist li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    padding: 10px 14px;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--olive);
    border-radius: 4px 8px 8px 4px;
    background: var(--paper-3);
  }
  .setlist b {
    font-size: 15px;
    background: none;
    padding: 0;
  }
  .sv {
    padding: 1px 8px;
    border-radius: 5px;
    background: var(--olive);
    color: #f6f1df;
    font-size: 12.5px;
    font-weight: 600;
  }
  .sw {
    flex-basis: 100%;
    color: var(--ink-3);
    font-size: 13px;
  }
  .lede b {
    color: var(--ink);
  }
</style>
