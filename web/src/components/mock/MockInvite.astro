---
import MockWindow from "./MockWindow.astro";
import Ring from "./Ring.astro";

// 게임 중 ESC → "친구 초대" 창. 친구마다 초대 / 수락 / 거절 버튼이 있다.
// 이름은 예시다.
const friends = [
  { n: "친구 A", s: "온라인 · 메인 메뉴" },
  { n: "친구 B", s: "온라인 · 메인 메뉴" },
  { n: "친구 C", s: "자리 비움" },
];
---

<MockWindow title="Project Zomboid — 친구 초대" variant="pz" icon="user-add-01">
  <div class="inv">
    <p class="h">친구 초대</p>
    <ul>
      {
        friends.map((f, i) => (
          <li>
            <span class="av">{f.n.slice(-1)}</span>
            <span class="who">
              <b>{f.n}</b>
              <small>{f.s}</small>
            </span>
            <span class="acts">
              <span class="b primary">
                초대
                {i === 0 && <Ring note="친구마다 초대" at="left" />}
              </span>
              <span class="b">수락</span>
              <span class="b">거절</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</MockWindow>

<style>
  .inv {
    padding: 22px 24px 24px;
    font-size: 13px;
  }
  .h {
    margin-bottom: 16px;
    font-size: 18px;
    font-weight: 700;
    color: #fff;
  }
  ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: rgb(0 0 0 / 0.35);
    border: 1px solid #3a3a32;
  }
  .av {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: #3d4a5c;
    color: #fff;
    font-weight: 700;
  }
  .who {
    display: grid;
    line-height: 1.3;
  }
  .who b {
    color: #e8e2d0;
  }
  .who small {
    color: #8e8a7e;
    font-size: 11.5px;
  }
  .acts {
    display: flex;
    gap: 6px;
  }
  .b {
    position: relative;
    padding: 5px 12px;
    border: 1px solid #4a4a40;
    background: #24241f;
    color: #c9c2ad;
    font-size: 12px;
  }
  .b.primary {
    border-color: #f0a93a;
    color: #f0a93a;
  }
</style>
