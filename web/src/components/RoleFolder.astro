---
import Icon from "./Icon.astro";

interface Props {
  tab: string;
  icon: string;
  title: string;
  desc: string;
  minutes: number;
  steps: number;
  href: string;
  cta: string;
  // 서류철 안에 꽂힌 종이에 타자로 친 듯 보이는 줄들
  sheet: string[];
  tone?: "red" | "ink";
  index?: number;
}
const { tab, icon, title, desc, minutes, steps, href, cta, sheet, tone = "ink", index = 0 } = Astro.props;
---

<a class={`folder ${tone} reveal`} href={href} style={`--i:${index}`}>
  <span class="tab">{tab}</span>
  <span class="back" aria-hidden="true"></span>
  <span class="paper" aria-hidden="true">
    <span class="paper-head mono">단계 목록 · {tab}</span>
    {
      sheet.map((s, i) => (
        <span class="paper-line">
          <span class="mono">{String(i + 1).padStart(2, "0")}</span>
          {s}
        </span>
      ))
    }
  </span>
  <span class="front">
    <span class="ic"><Icon name={icon} size={30} /></span>
    <span class="title display">{title}</span>
    <span class="desc">{desc}</span>
    <span class="meta">
      <span><Icon name="timer-01" size={15} />약 {minutes}분</span>
      <span><Icon name="list-view" size={15} />{steps}단계</span>
    </span>
    <span class="go">
      {cta}
      <Icon name="arrow-right-02" size={20} />
    </span>
  </span>
</a>

<style>
  .folder {
    --manila: #d8b878;
    --manila-dark: #c4a063;
    --manila-edge: #a9874c;
    position: relative;
    display: block;
    min-height: 470px;
    padding-top: 38px;
    color: #2a2316;
    text-decoration: none;
    perspective: 1200px;
  }
  @media (prefers-color-scheme: dark) {
    .folder {
      --manila: #b99a5e;
      --manila-dark: #a2834b;
      --manila-edge: #7c6337;
    }
  }
  .tab {
    position: absolute;
    top: 0;
    left: 26px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    height: 42px;
    padding: 0 20px 4px;
    border-radius: 10px 10px 0 0;
    background: var(--manila-dark);
    font-family: var(--f-stencil);
    font-size: 17px;
    letter-spacing: 0.1em;
    color: #3a2f1c;
  }
  .red .tab {
    color: #8f1f14;
  }
  .back {
    position: absolute;
    inset: 38px 0 0 0;
    border-radius: 4px 12px 12px 12px;
    background: var(--manila-dark);
    box-shadow: var(--shadow-sheet);
  }
  .paper {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 58px;
    z-index: 1;
    display: grid;
    align-content: start;
    gap: 6px;
    height: 230px;
    padding: 16px 18px;
    background:
      repeating-linear-gradient(180deg, transparent 0 25px, rgb(47 74 99 / 0.12) 25px 26px),
      #f7f2e3;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.15);
    rotate: -1.2deg;
    transition:
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1),
      rotate 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .paper-head {
    margin-bottom: 4px;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #b02a1c;
  }
  .paper-line {
    display: flex;
    gap: 10px;
    font-size: 13.5px;
    line-height: 1.45;
    color: #2a2316;
  }
  .paper-line .mono {
    color: #8a8068;
    font-size: 11.5px;
    padding-top: 2px;
  }
  .front {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: grid;
    gap: 10px;
    min-height: 66%;
    padding: 30px 28px 26px;
    border-radius: 6px 6px 12px 12px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.18), transparent 40%),
      var(--manila);
    border-top: 2px solid var(--manila-edge);
    box-shadow:
      0 -8px 18px -10px rgb(60 40 10 / 0.5),
      inset 0 1px 0 rgb(255 255 255 / 0.35);
    transform-origin: bottom center;
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .ic {
    position: absolute;
    top: -30px;
    right: 26px;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #23201a;
    color: var(--manila);
    box-shadow: 0 10px 20px -8px rgb(0 0 0 / 0.6);
  }
  .red .ic {
    background: var(--red);
    color: #fff3df;
  }
  .title {
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.15;
  }
  .desc {
    max-width: 32em;
    font-size: 15px;
    line-height: 1.6;
    color: #4a3f29;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgb(42 35 22 / 0.1);
    font-family: var(--f-mono);
    font-size: 12.5px;
  }
  .go {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 6px;
    padding: 14px 18px;
    border: 2px solid #23201a;
    border-radius: var(--radius);
    background: #23201a;
    color: #f4ecd5;
    font-size: 16px;
    font-weight: 700;
    box-shadow: 4px 4px 0 rgb(0 0 0 / 0.25);
    transition:
      background 160ms ease,
      transform 160ms ease;
  }
  .red .go {
    background: var(--red);
    border-color: #23201a;
  }

  .folder:hover .paper,
  .folder:focus-visible .paper {
    transform: translateY(-34px);
    rotate: 1.5deg;
  }
  .folder:hover .front,
  .folder:focus-visible .front {
    transform: rotateX(10deg);
  }
  .folder:hover .go {
    transform: translateX(3px);
  }
  .folder:hover .go :global(.icon) {
    animation: nudge 900ms ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateX(4px);
    }
  }
  .folder:focus-visible {
    outline-offset: 8px;
  }
</style>
