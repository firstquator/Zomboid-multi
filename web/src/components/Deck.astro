---
import "../styles/deck.css";
import Icon from "./Icon.astro";

interface Props {
  // localStorage 키, 주소(#host-3), 진행 기록에 쓴다. 가이드마다 달라야 한다.
  id: string;
  name: string;
  icon: string;
  minutes: number;
  // 슬라이드 제목. 순서가 슬롯 안 Slide 순서와 같아야 한다.
  steps: string[];
  // 마지막 장의 버튼. role 이 있으면 같은 페이지의 다른 가이드로 바꾼다.
  finish: { href: string; label: string; role?: string };
  // 한 페이지에 가이드가 여럿이면 위쪽에 바꾸는 버튼을 단다.
  roles?: { id: string; label: string; icon: string }[];
  hidden?: boolean;
}
const { id, name, icon, minutes, steps, finish, roles, hidden = false } = Astro.props;
const last = steps.length - 1;

// 경로 선. 핀이 놓이는 자리마다 사인 곡선이 가운데 선을 지나도록
// 주기를 핀 간격에 맞춘다. 그래야 구불구불한 길 위에 핀이 정확히 앉는다.
const W = 1000;
const seg = W / last;
let d = "M0 20";
for (let i = 0; i < last; i++) {
  const x0 = i * seg;
  const dir = i % 2 === 0 ? -1 : 1;
  d += ` C${(x0 + seg * 0.36).toFixed(1)} ${20 + dir * 9} ${(x0 + seg * 0.64).toFixed(1)} ${20 + dir * 9} ${(x0 + seg).toFixed(1)} 20`;
}
---

<div class="deck" data-deck={id} data-last={last} hidden={hidden}>
  <div class="deck-top">
    {
      roles ? (
        <p class="deck-name">
          <span class="roles" role="group" aria-label="가이드 고르기">
            {roles.map((r) => (
              <a href={`#${r.id}-0`} data-role={r.id} aria-current={r.id === id ? "page" : undefined}>
                <Icon name={r.icon} size={16} />
                <span>{r.label}</span>
              </a>
            ))}
          </span>
          <span class="deck-time">
            <Icon name="timer-01" size={14} />약 {minutes}분
          </span>
        </p>
      ) : (
        <p class="deck-name">
          <Icon name={icon} size={18} />
          <span>{name}</span>
          <span class="deck-time">
            <Icon name="timer-01" size={14} />약 {minutes}분
          </span>
        </p>
      )
    }
    <p class="deck-now" aria-live="polite" data-deck-now></p>
    <details class="toc">
      <summary>
        <Icon name="list-view" size={18} />
        <span>목차</span>
      </summary>
      <ol>
        {
          steps.map((s, i) => (
            <li>
              <a href={`#step-${i}`} data-goto={i}>
                <span class="toc-n mono">{i === 0 ? "시작" : i === last ? "완료" : String(i).padStart(2, "0")}</span>
                <span>{s}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </details>
  </div>

  <div class="track" data-track>
    <slot />
  </div>

  <div class="resume" data-resume hidden>
    <Icon name="bookmark-01" size={18} />
    <span data-resume-text>지난번 보던 단계가 있어요</span>
    <button type="button" data-resume-go>이어서 보기</button>
    <button type="button" class="x" data-resume-close aria-label="닫기"><Icon name="cancel-01" size={16} /></button>
  </div>

  <nav class="deck-nav" aria-label="단계 이동">
    <button class="nav-btn prev" type="button" data-prev aria-label="이전 단계">
      <Icon name="arrow-left-02" size={22} />
      <span class="nav-label">이전</span>
    </button>

    <div class="route" style={`--last:${last}`}>
      <svg class="route-line" viewBox={`0 0 ${W} 40`} preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <clipPath id={`route-clip-${id}`}>
            <rect class="route-clip" x="-10" y="-20" height="80" data-route-clip />
          </clipPath>
        </defs>
        <path class="route-bg" d={d} pathLength="1" />
        <path class="route-fg" d={d} clip-path={`url(#route-clip-${id})`} />
      </svg>
      <ol class="pins">
        {
          steps.map((s, i) => (
            <li style={`--x:${(i / last) * 100}%`}>
              <button type="button" class="pin" data-goto={i} aria-label={`${i === 0 ? "시작" : i === last ? "완료" : i + "단계"}: ${s}`}>
                {i === 0 ? (
                  <Icon name="flag-02" size={14} />
                ) : i === last ? (
                  <Icon name="home-01" size={14} />
                ) : (
                  <span class="mono">{i}</span>
                )}
              </button>
              <span class="pin-tip" aria-hidden="true">{s}</span>
            </li>
          ))
        }
      </ol>
      <span class="marker" aria-hidden="true" data-marker>
        <Icon name="location-01" size={26} />
      </span>
      <p class="route-mobile mono" aria-hidden="true" data-count>시작</p>
      <div class="route-bar" aria-hidden="true"><i data-bar></i></div>
    </div>

    <button class="nav-btn next" type="button" data-next aria-label="다음 단계">
      <span class="nav-label">다음</span>
      <Icon name="arrow-right-02" size={22} />
    </button>
    <a class="nav-btn next finish" href={finish.href} data-finish data-role={finish.role} hidden>
      <span class="nav-label">{finish.label}</span>
      <Icon name="arrow-right-02" size={22} />
    </a>
  </nav>
</div>

<script>
  // 한 페이지에 가이드(Deck)가 여럿일 수 있다(가이드 페이지의 호스트·참가자).
  // 보이는 가이드만 키보드와 주소(#host-3)를 쓰고, 위쪽 버튼이나 마지막 장 버튼으로 바꾼다.
  type DeckApi = { id: string; el: HTMLElement; show: (step?: number) => void; start: (step: number | null) => void };
  const decks = Array.from(document.querySelectorAll<HTMLElement>("[data-deck]")).map(initDeck);
  const multi = decks.length > 1;
  const hashFor = (id: string, i: number) => (multi ? `#${id}-${i}` : `#step-${i}`);

  function showRole(id: string, step?: number) {
    const d = decks.find((x) => x.id === id);
    if (!d) return;
    decks.forEach((x) => (x.el.hidden = x !== d));
    d.show(step);
  }
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>("[data-role]");
    if (!a?.dataset.role || !multi) return;
    e.preventDefault();
    // 위쪽 버튼은 그 가이드에서 보던 곳으로, 마지막 장 버튼은 처음으로 간다.
    showRole(a.dataset.role, a.hasAttribute("data-finish") ? 0 : undefined);
  });

  // 같은 페이지에서 주소의 # 만 바뀐 경우(링크, 직접 입력)에도 그 가이드로 바꾼다.
  window.addEventListener("hashchange", () => {
    const m = /^#([a-z]+)(?:-(\d+))?$/.exec(location.hash);
    if (multi && m && decks.some((d) => d.id === m[1])) showRole(m[1], m[2] ? Number(m[2]) : undefined);
  });

  // 처음 열 때: #join-2, #join, 예전 주소 #step-2 순서로 읽는다.
  if (decks.length) {
    const h = location.hash;
    const m = /^#([a-z]+)(?:-(\d+))?$/.exec(h);
    const old = /^#step-(\d+)$/.exec(h);
    const byHash = m ? decks.find((d) => d.id === m[1]) : undefined;
    const first = byHash ?? decks.find((d) => !d.el.hidden) ?? decks[0];
    decks.forEach((d) => (d.el.hidden = d !== first));
    const step = byHash && m?.[2] ? Number(m[2]) : old ? Number(old[1]) : null;
    first.start(step);
  }

  function initDeck(deck: HTMLElement): DeckApi {
    const id = deck.dataset.deck!;
    const track = deck.querySelector<HTMLElement>("[data-track]")!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>(".slide"));
    const last = slides.length - 1;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const storeKey = `zm-deck:${id}`;
    const visible = () => !deck.hidden;

    const prev = deck.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = deck.querySelector<HTMLButtonElement>("[data-next]")!;
    const finish = deck.querySelector<HTMLElement>("[data-finish]")!;
    const now = deck.querySelector<HTMLElement>("[data-deck-now]")!;
    // 진행선은 빨간 선 전체를 그려 두고 왼쪽부터 잘라 보여 준다. 점선 길이로 자르면
    // 선 두께 고정(non-scaling-stroke)과 섞여 넓은 화면에서 핀까지 닿지 않는다.
    const routeClip = deck.querySelector<SVGRectElement>("[data-route-clip]")!;
    const ROUTE_W = routeClip.ownerSVGElement?.viewBox.baseVal.width ?? 1000;
    const marker = deck.querySelector<HTMLElement>("[data-marker]")!;
    const count = deck.querySelector<HTMLElement>("[data-count]")!;
    const bar = deck.querySelector<HTMLElement>("[data-bar]")!;
    const pins = Array.from(deck.querySelectorAll<HTMLElement>(".pin"));
    const toc = deck.querySelector<HTMLDetailsElement>(".toc");

    let cur = -1;

    const save = (i: number) => {
      try {
        localStorage.setItem(storeKey, String(i));
      } catch {
        // 사생활 보호 모드 등에서 막혀도 진행 기록만 못 남길 뿐이다.
      }
    };
    const load = () => {
      try {
        return Number(localStorage.getItem(storeKey) ?? "0") || 0;
      } catch {
        return 0;
      }
    };

    function setActive(i: number, force = false) {
      if (i === cur && !force) return;
      cur = i;
      slides.forEach((s, k) => {
        const on = k === i;
        s.classList.toggle("is-active", on);
        s.classList.toggle("is-past", k < i);
        // 화면 밖 슬라이드에 Tab 이 들어가면 보이지 않는 버튼을 누르게 된다.
        s.toggleAttribute("inert", !on);
      });
      pins.forEach((p, k) => {
        p.classList.toggle("done", k < i);
        p.classList.toggle("here", k === i);
        if (k === i) p.setAttribute("aria-current", "step");
        else p.removeAttribute("aria-current");
      });
      const frac = last ? i / last : 0;
      routeClip.style.width = `${frac * ROUTE_W + 10}px`;
      marker.style.setProperty("--x", `${frac * 100}%`);
      bar.style.width = `${frac * 100}%`;
      // 표지와 끝 장은 단계 수에 넣지 않는다. 실제 단계는 last - 1 개다.
      count.textContent = i === 0 ? "시작" : i === last ? "완료" : `${i} / ${last - 1}`;
      now.textContent = i === 0 ? "" : i === last ? "완료" : `${i}단계 · ${slides[i].dataset.title}`;

      prev.disabled = i === 0;
      const atEnd = i === last;
      next.hidden = atEnd;
      finish.hidden = !atEnd;

      // 숨은 가이드는 주소와 기록을 건드리지 않는다.
      if (visible()) {
        history.replaceState(null, "", hashFor(id, i));
        save(i);
      }
    }

    function go(i: number, smooth = true) {
      const k = Math.max(0, Math.min(last, i));
      track.scrollTo({ left: slides[k].offsetLeft, behavior: smooth && !reduce ? "smooth" : "auto" });
      setActive(k);
    }

    // 손가락으로 밀어서 넘긴 경우에도 현재 단계를 따라간다.
    const io = new IntersectionObserver(
      (entries) => {
        if (!visible()) return;
        for (const e of entries) {
          if (e.isIntersecting) setActive(slides.indexOf(e.target as HTMLElement));
        }
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));

    prev.addEventListener("click", () => go(cur - 1));
    next.addEventListener("click", () => go(cur + 1));
    deck.addEventListener("click", (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>("[data-goto]");
      if (!t) return;
      e.preventDefault();
      go(Number(t.dataset.goto));
      if (toc) toc.open = false;
    });

    document.addEventListener("keydown", (e) => {
      if (!visible()) return;
      const tag = (e.target as HTMLElement).tagName;
      if (["INPUT", "TEXTAREA", "SELECT"].includes(tag) || e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.key === "ArrowRight" || e.key === "PageDown") {
        e.preventDefault();
        go(cur + 1);
      } else if (e.key === "ArrowLeft" || e.key === "PageUp") {
        e.preventDefault();
        go(cur - 1);
      } else if (e.key === "Home") {
        go(0);
      } else if (e.key === "End") {
        go(last);
      } else if (e.key === "Escape" && toc?.open) {
        toc.open = false;
      }
    });

    window.addEventListener("resize", () => visible() && go(cur, false));

    // 다른 가이드에서 바꿔 왔을 때. 숨어 있던 동안은 크기가 0이라 보인 뒤에 자리를 맞춘다.
    function show(step?: number) {
      requestAnimationFrame(() => {
        const k = Math.max(0, Math.min(last, step ?? Math.max(cur, 0)));
        track.scrollTo({ left: slides[k].offsetLeft, behavior: "auto" });
        setActive(k, true);
      });
    }

    // 처음 열 때: 주소에 단계가 있으면 거기로, 없으면 지난번 기록을 제안한다.
    function start(step: number | null) {
      if (step !== null && Number.isFinite(step)) {
        requestAnimationFrame(() => go(step, false));
        return;
      }
      go(0, false);
      const saved = load();
      if (saved > 0 && saved <= last) {
        const box = deck.querySelector<HTMLElement>("[data-resume]")!;
        deck.querySelector<HTMLElement>("[data-resume-text]")!.textContent =
          `지난번에 ${saved === last ? "끝까지" : saved + "단계까지"} 봤습니다`;
        box.hidden = false;
        deck.querySelector("[data-resume-go]")!.addEventListener("click", () => {
          box.hidden = true;
          go(saved);
        });
        deck.querySelector("[data-resume-close]")!.addEventListener("click", () => {
          box.hidden = true;
        });
        setTimeout(() => (box.hidden = true), 12000);
      }
    }

    // 숨은 가이드도 첫 장 상태는 그려 둔다(주소는 바꾸지 않는다).
    if (!visible()) setActive(0);
    return { id, el: deck, show, start };
  }
</script>

<style>
  .deck[hidden] {
    display: none;
  }
  /* deck.css 가 좁은 화면에서 첫 칸(가이드 이름)을 줄이는데, 전환 버튼은 줄이지 않는다 */
  .deck-name > .roles {
    max-width: none;
    overflow: visible;
  }
  .roles {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
  }
  .roles a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 150ms ease,
      color 150ms ease;
  }
  .roles a:hover {
    color: var(--ink);
  }
  .roles a[aria-current="page"] {
    background: var(--ink);
    color: var(--paper-3);
    box-shadow: 0 2px 6px -2px rgb(0 0 0 / 0.4);
  }
  @media (max-width: 560px) {
    .roles a {
      padding: 6px 10px;
      font-size: 13px;
    }
    /* 좁은 화면에서는 전환 버튼이 잘리지 않게 걸리는 시간을 뺀다 */
    .roles + .deck-time {
      display: none;
    }
  }
</style>
