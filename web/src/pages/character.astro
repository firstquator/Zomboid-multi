---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import PixelIcon from "../components/PixelIcon.astro";
import { base } from "../lib/base-url.mjs";
import { remainingPoints, SLEEP_TRAITS } from "../lib/character.mjs";
import { builds, buildGroups, verdicts, spawnTips, firstDay } from "../data/builds.mjs";
import data from "../data/character.json";

const TAG: Record<string, { label: string; rank: number }> = {
  good: { label: "추천", rank: 0 },
  ok: { label: "상황에 따라", rank: 1 },
  server: { label: "효과 거의 없음", rank: 3 },
  bad: { label: "피하기", rank: 4 },
  off: { label: "선택 불가", rank: 5 },
};

const profById = new Map(data.professions.map((p) => [p.id, p]));
const traitById = new Map(data.traits.map((t) => [t.id, t]));
const pickable = data.traits.filter((t) => !t.professionOnly);
const positives = pickable.filter((t) => t.cost > 0);
const negatives = pickable.filter((t) => t.cost < 0);

// 게임 설명에 섞인 <br> 을 문장 구분으로 바꾼다.
const clean = (s: string) => s.replace(/<br\s*\/?>/gi, " · ").replace(/\s+/g, " ").trim();
// 남은 포인트에 주는 영향으로 보여 준다. 긍정 특성은 포인트를 쓰므로 음수.
const fx = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${-n}` : "0");
const rank = (id: string) => TAG[verdicts[id]?.tag]?.rank ?? 2;

const buildCards = builds.map((b) => {
  const p = profById.get(b.profession)!;
  const good = b.good.map((id) => traitById.get(id)!);
  const bad = b.bad.map((id) => traitById.get(id)!);
  return { ...b, p, good, bad, left: remainingPoints(p, [...good, ...bad]) };
});
const groupCount = Object.fromEntries(buildGroups.map((g) => [g.id, builds.filter((b) => b.group === g.id).length]));

// 계산기가 쓰는 데이터만 페이지에 넣는다.
const clientData = {
  professions: data.professions.map(({ id, name, cost, xp, granted, icon }) => ({ id, name, cost, xp, granted, icon })),
  traits: pickable.map(({ id, name, cost, exclusive, xp, icon }) => ({ id, name, cost, exclusive, xp, icon })),
  granted: Object.fromEntries(data.traits.filter((t) => t.professionOnly).map((t) => [t.id, t.name])),
  off: SLEEP_TRAITS,
  builds: builds.map((b) => ({ id: b.id, title: b.title, profession: b.profession, traits: [...b.good, ...b.bad] })),
  base: import.meta.env.BASE_URL.replace(/\/+$/, ""),
};

const traitCard = (t: any) => ({
  ...t,
  verdict: verdicts[t.id],
  search: `${t.name} ${t.nameEn} ${clean(t.desc)} ${t.xp.map((x: any) => x.name).join(" ")}`.toLowerCase(),
});
---

<Base title="캐릭터 만들기" active="character">
  <PageHead
    kicker={`Build ${data.build} · 직업과 특성`}
    title="캐릭터 만들기"
    desc="처음 시작할 때 고르는 직업과 특성을 정리했습니다. 수치는 게임 파일에서 그대로 가져왔고, 우리 서버 설정에 맞춘 추천을 붙였습니다."
    icon="user"
    seed={45}
  >
    <nav class="jump" aria-label="이 페이지 안에서 이동">
      <a href="#rules"><Icon name="information-circle" size={16} />포인트 계산법</a>
      <a href="#builds"><Icon name="star" size={16} />추천 조합 {builds.length}개</a>
      <a href="#builder"><Icon name="sliders-horizontal" size={16} />직접 짜 보기</a>
      <a href="#start"><Icon name="maps-location-01" size={16} />시작 직후</a>
    </nav>
  </PageHead>

  <section class="wrap sec" id="rules" aria-labelledby="rules-title">
    <p class="kicker">01</p>
    <h2 id="rules-title" class="display">포인트 계산법</h2>

    <div class="eq reveal">
      <div class="term">
        <span class="t-k">직업 포인트</span>
        <span class="t-v">커스텀 직업 <b class="plus">+8</b> · 소방관 <b>0</b> · 퇴역 군인 <b class="minus">−8</b></span>
      </div>
      <span class="op" aria-label="빼기">−</span>
      <div class="term">
        <span class="t-k">긍정 특성 비용</span>
        <span class="t-v">두꺼운 피부 <b class="minus">8</b> · 민첩함 <b class="minus">2</b></span>
      </div>
      <span class="op" aria-label="더하기">+</span>
      <div class="term">
        <span class="t-k">부정 특성 보상</span>
        <span class="t-v">대식가 <b class="plus">4</b> · 정독 <b class="plus">2</b></span>
      </div>
      <span class="op" aria-label="0 이상">≥</span>
      <div class="term zero">
        <span class="t-k">남은 포인트</span>
        <span class="t-big">0</span>
      </div>
    </div>
    <p class="lede">남은 포인트가 0 이상이면 시작할 수 있습니다. 남은 포인트는 다른 곳에 쓸 수 없어서 0에 가깝게 맞추는 게 좋습니다.</p>

    <ul class="notes">
      <li class="reveal" style="--i:0">
        <span class="n-ic"><Icon name="moon-02" size={20} /></span>
        <span><b>수면 특성 3개는 고를 수 없음</b>잠 설정이 꺼진 멀티 서버라 수면장애, 잠꾸러기, 잠이 적음이 목록에서 빠집니다. 피로도 쌓이지 않습니다.</span>
      </li>
      <li class="reveal" style="--i:1">
        <span class="n-ic"><Icon name="book-open-01" size={20} /></span>
        <span><b>책을 거의 바로 읽음</b>독서 시간이 한 쪽당 0.1분이라 <em>속독</em>은 효과가 거의 없고 <em>정독</em>은 사실상 공짜 2점입니다. <em>문맹</em>은 기술 서적을 못 읽어 손해가 큽니다.</span>
      </li>
      <li class="reveal" style="--i:2">
        <span class="n-ic"><Icon name="book-02" size={20} /></span>
        <span><b>스킬 보존 일지가 있음</b>일지에 기록한 기술은 죽은 뒤 되찾습니다. 그래서 <em>현자</em>처럼 성장을 빠르게 하는 특성의 가치가 오릅니다.</span>
      </li>
    </ul>
  </section>

  <section class="wrap sec" id="builds" aria-labelledby="builds-title">
    <p class="kicker">02</p>
    <div class="sec-row">
      <h2 id="builds-title" class="display">추천 조합</h2>
      <div class="seg" role="tablist" aria-label="갈래" data-build-filter>
        <button type="button" role="tab" aria-selected="true" data-group="all">전체 <span class="mono">{builds.length}</span></button>
        {
          buildGroups.map((g) => (
            <button type="button" role="tab" aria-selected="false" data-group={g.id}>
              {g.label} <span class="mono">{groupCount[g.id]}</span>
            </button>
          ))
        }
      </div>
    </div>
    <p class="lede">역할별 조합입니다. 모두 게임 수치로 포인트가 맞는지 검사했습니다. 마음에 드는 조합을 불러와 계산기에서 바꿔 볼 수 있습니다.</p>

    <div class="build-grid" data-build-grid>
      {
        buildCards.map((b, i) => (
          <article class="build reveal" data-group={b.group} style={`--i:${i % 3}`}>
            <header class="b-head">
              <PixelIcon src={b.p.icon} size={36} fallback="user" />
              <div class="b-title">
                <h3 class="display">{b.title}</h3>
                <p class="b-sub">
                  <span class="b-tag">{b.tag}</span> · {b.p.name} <span class="mono">{fx(b.p.cost)}</span>
                </p>
              </div>
              <span class={`b-left ${b.left > 0 ? "rest" : ""}`} title="남은 포인트">
                남은 <b class="mono">{b.left}</b>
              </span>
            </header>
            <p class="b-who">{b.who}</p>
            <ul class="b-chips" aria-label="긍정 특성">
              {b.good.map((t) => (
                <li class="pos">
                  <PixelIcon src={t.icon} size={18} />
                  {t.name}
                  <span class="mono">{fx(-t.cost)}</span>
                </li>
              ))}
            </ul>
            <ul class="b-chips neg" aria-label="부정 특성">
              {b.bad.map((t) => (
                <li class="neg" title={t.name}>
                  <PixelIcon src={t.icon} size={18} />
                  {t.name}
                  <span class="mono">{fx(-t.cost)}</span>
                </li>
              ))}
            </ul>
            <details class="b-why">
              <summary>왜 이렇게?</summary>
              <ul>
                {b.why.map((w) => (
                  <li>{w}</li>
                ))}
              </ul>
            </details>
            <button type="button" class="b-load" data-load-build={b.id}>
              <Icon name="sliders-horizontal" size={16} />
              불러와서 바꿔 보기
            </button>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap sec" id="builder" aria-labelledby="builder-title">
    <p class="kicker">03</p>
    <h2 id="builder-title" class="display">직접 짜 보기</h2>
    <p class="lede">직업 → 긍정 특성 → 부정 특성 순서로 고릅니다. 함께 못 고르는 특성은 자동으로 막히고, 요약에서 바로 뺄 수 있습니다.</p>

    <script type="application/json" id="char-data" set:html={JSON.stringify(clientData)} />

    <div class="builder" data-builder>
      <div class="main">
        <div class="tabs" role="tablist" aria-label="고르는 단계">
          <button type="button" role="tab" id="tab-prof" aria-controls="panel-prof" aria-selected="true" data-tab="prof">
            <span class="tab-n mono">1</span>
            <span class="tab-t">직업<small data-tab-sub="prof">커스텀 직업</small></span>
          </button>
          <button type="button" role="tab" id="tab-pos" aria-controls="panel-pos" aria-selected="false" data-tab="pos">
            <span class="tab-n mono">2</span>
            <span class="tab-t">긍정 특성<small data-tab-sub="pos">0개</small></span>
          </button>
          <button type="button" role="tab" id="tab-neg" aria-controls="panel-neg" aria-selected="false" data-tab="neg">
            <span class="tab-n mono">3</span>
            <span class="tab-t">부정 특성<small data-tab-sub="neg">0개</small></span>
          </button>
        </div>

        <div class="panel" role="tabpanel" id="panel-prof" aria-labelledby="tab-prof" data-panel="prof">
          <div class="profs">
            {
              data.professions.map((p) => (
                <button type="button" class="prof" data-prof={p.id} aria-pressed="false">
                  <PixelIcon src={p.icon} size={28} fallback="user" />
                  <span class="p-main">
                    <span class="p-name">{p.name}</span>
                    <span class="p-xp">{p.xp.slice(0, 2).map((x) => `${x.name} +${x.level}`).join(" · ") || "기술 보너스 없음"}</span>
                  </span>
                  <span class={`mono pts ${p.cost > 0 ? "plus" : p.cost < 0 ? "minus" : ""}`}>{fx(p.cost)}</span>
                </button>
              ))
            }
          </div>
          <div class="panel-foot">
            <p class="prof-detail" data-prof-detail aria-live="polite"></p>
            <button type="button" class="next" data-go="pos">긍정 특성 고르기 <Icon name="arrow-right-02" size={18} /></button>
          </div>
        </div>

        {
          [
            { id: "pos", list: positives, next: "neg", nextLabel: "부정 특성 고르기", hint: "포인트를 쓰는 특성" },
            { id: "neg", list: negatives, next: "", nextLabel: "", hint: "포인트를 돌려받는 특성" },
          ].map((panel) => (
            <div class="panel" role="tabpanel" id={`panel-${panel.id}`} aria-labelledby={`tab-${panel.id}`} data-panel={panel.id} hidden>
              <div class="tools">
                <label class="search">
                  <Icon name="search-01" size={16} />
                  <input type="search" placeholder="이름이나 기술로 찾기" data-search={panel.id} aria-label="특성 찾기" />
                </label>
                <div class="seg small" role="group" aria-label="보기">
                  <button type="button" aria-pressed="false" data-only-good={panel.id}>추천만</button>
                  <button type="button" aria-pressed="true" data-sort={`${panel.id}:rank`}>추천순</button>
                  <button type="button" aria-pressed="false" data-sort={`${panel.id}:cost`}>점수순</button>
                </div>
              </div>
              <p class="panel-hint">{panel.hint}. 숫자는 남은 포인트에 주는 영향입니다.</p>
              <div class="traits" data-list={panel.id}>
                {panel.list.map(traitCard).map((t: any) => (
                  <button
                    type="button"
                    class="trait"
                    data-trait={t.id}
                    data-tag={t.verdict?.tag ?? ""}
                    data-rank={rank(t.id)}
                    data-cost={Math.abs(t.cost)}
                    data-search-text={t.search}
                    aria-pressed="false"
                  >
                    <PixelIcon src={t.icon} size={22} />
                    <span class="t-main">
                      <span class="t-name">
                        {t.name}
                        {t.verdict && <span class={`tag ${t.verdict.tag}`}>{TAG[t.verdict.tag].label}</span>}
                      </span>
                      <span class="t-desc">{t.verdict?.note ?? clean(t.desc)}</span>
                      {t.xp.length > 0 && (
                        <span class="t-xp">
                          {t.xp.map((x: any) => (
                            <span class="xp">
                              {x.name} {x.level > 0 ? `+${x.level}` : x.level}
                            </span>
                          ))}
                        </span>
                      )}
                      <span class="t-why" data-why />
                    </span>
                    <span class={`mono pts ${t.cost > 0 ? "minus" : "plus"}`}>{fx(-t.cost)}</span>
                    <span class="t-check" aria-hidden="true">
                      <Icon name="tick-02" size={14} />
                    </span>
                  </button>
                ))}
              </div>
              <p class="empty" data-empty={panel.id} hidden>
                찾는 특성이 없습니다.
              </p>
              {panel.next && (
                <div class="panel-foot">
                  <span />
                  <button type="button" class="next" data-go={panel.next}>
                    {panel.nextLabel} <Icon name="arrow-right-02" size={18} />
                  </button>
                </div>
              )}
            </div>
          ))
        }
      </div>

      <aside class="summary" aria-label="고른 결과" data-summary>
        <div class="s-card">
          <div class="s-top">
            <div>
              <p class="s-k">남은 포인트</p>
              <p class="s-points mono" data-points>8</p>
            </div>
            <button type="button" class="s-close" data-sheet-close aria-label="요약 닫기"><Icon name="cancel-01" size={18} /></button>
          </div>
          <div class="meter" aria-hidden="true"><i data-meter></i></div>
          <p class="s-budget mono" data-budget></p>
          <p class="s-state" data-state>시작할 수 있습니다</p>

          <div class="s-block">
            <p class="s-k">직업</p>
            <button type="button" class="s-prof" data-go="prof">
              <span data-s-prof-icon></span>
              <span data-s-prof>커스텀 직업</span>
              <small>바꾸기</small>
            </button>
          </div>
          <div class="s-block">
            <p class="s-k">긍정 특성</p>
            <ul class="s-list" data-s-list="pos"></ul>
          </div>
          <div class="s-block">
            <p class="s-k">부정 특성</p>
            <ul class="s-list" data-s-list="neg"></ul>
          </div>
          <div class="s-block">
            <p class="s-k">오르는 기술</p>
            <ul class="s-skills" data-skills></ul>
          </div>

          <div class="s-actions">
            <button type="button" class="s-btn" data-reset><Icon name="refresh" size={16} />처음부터</button>
            <button type="button" class="s-btn primary" data-share><Icon name="link-01" size={16} /><span data-share-label>링크 복사</span></button>
          </div>
          <p class="s-hint">링크를 보내면 친구도 같은 조합을 열어 봅니다.</p>
        </div>
      </aside>
    </div>

    <div class="sheet-backdrop" data-sheet-backdrop hidden></div>
    <button type="button" class="sheet-bar" data-sheet-open aria-label="고른 결과 보기">
      <span>남은 <b class="mono" data-points-mini>8</b></span>
      <span class="sb-mid" data-sheet-sum>긍정 0 · 부정 0</span>
      <span class="sb-open">요약 <Icon name="arrow-up-01" size={14} /></span>
    </button>
  </section>

  <section class="wrap sec two" id="start" aria-labelledby="start-title">
    <div>
      <p class="kicker">04</p>
      <h2 id="start-title" class="display">시작 지역</h2>
      <ul class="tips">
        {spawnTips.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    </div>
    <div>
      <p class="kicker">05</p>
      <h2 class="display">시작 직후 할 일</h2>
      <ol class="first">
        {
          firstDay.map((f, i) => (
            <li class="reveal" style={`--i:${i % 3}`}>
              <span class="f-ic">
                <Icon name={f.icon} size={20} />
              </span>
              <span>
                <b>{f.title}</b>
                {f.text}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <p class="wrap credit">
    직업·특성 이름, 수치, 아이콘은 Project Zomboid {data.build} 게임 파일에서 가져왔습니다. 아이콘의 저작권은 The Indie Stone 에 있습니다.
    참가자 접속 방법은 <a href={base("join/")}>참가자 가이드</a>를 보세요.
  </p>
</Base>

<script>
  import { remainingPoints, conflicts, skillTotals, encodeBuild, decodeBuild } from "../lib/character.mjs";

  type Prof = { id: string; name: string; cost: number; xp: any[]; granted: string[]; icon: string | null };
  type Trait = { id: string; name: string; cost: number; exclusive: string[]; xp: any[]; icon: string | null };
  const D = JSON.parse(document.getElementById("char-data")!.textContent!);
  const profs = new Map<string, Prof>(D.professions.map((p: Prof) => [p.id, p]));
  const traits = new Map<string, Trait>(D.traits.map((t: Trait) => [t.id, t]));
  const off = new Set<string>(D.off);

  let profId = "unemployed";
  let chosen = new Set<string>();
  // 처음 열 때는 주소를 바꾸지 않는다. 고르기 시작한 뒤부터 조합을 주소에 남긴다.
  let touched = false;

  const $ = <T extends Element>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const $$ = <T extends Element>(s: string, root: ParentNode = document) => Array.from(root.querySelectorAll<T>(s));
  const fx = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${-n}` : "0");
  const icon = (src: string | null, size = 18) =>
    src ? `<img src="${D.base}/${src}" alt="" width="${size}" height="${size}" style="image-rendering:pixelated">` : "";
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  // ── 탭 ──
  const tabs = $$<HTMLButtonElement>("[data-tab]");
  function showTab(id: string, focus = false) {
    tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.tab === id)));
    $$<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== id));
    if (focus) document.querySelector<HTMLElement>(`[data-tab="${id}"]`)?.focus();
  }
  tabs.forEach((t) => t.addEventListener("click", () => showTab(t.dataset.tab!)));
  // 좌우 화살표로 탭 이동
  $(".tabs").addEventListener("keydown", (e) => {
    const k = (e as KeyboardEvent).key;
    if (k !== "ArrowRight" && k !== "ArrowLeft") return;
    const i = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
    const n = tabs[(i + (k === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
    showTab(n.dataset.tab!, true);
  });
  document.addEventListener("click", (e) => {
    const go = (e.target as HTMLElement).closest<HTMLElement>("[data-go]");
    if (!go) return;
    showTab(go.dataset.go!);
    closeSheet();
    $("[data-builder]").scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // ── 고를 수 없는 이유 ──
  function blocked(t: Trait, p: Prof) {
    if (off.has(t.id)) return "우리 서버에서는 고를 수 없음";
    if (p.granted.includes(t.id)) return "직업이 이미 줌";
    for (const g of p.granted) if (t.exclusive.includes(g)) return `직업 특성(${D.granted[g] ?? g})과 함께 못 고름`;
    for (const id of chosen) {
      const other = traits.get(id)!;
      if (t.exclusive.includes(id) || other.exclusive.includes(t.id)) return `${other.name}와 함께 못 고름`;
    }
    return "";
  }

  // ── 그리기 ──
  const profBtns = $$<HTMLButtonElement>("[data-prof]");
  const traitBtns = $$<HTMLButtonElement>("[data-trait]");

  function render() {
    const p = profs.get(profId)!;
    const ts = [...chosen].map((id) => traits.get(id)!);
    const pos = ts.filter((t) => t.cost > 0);
    const neg = ts.filter((t) => t.cost < 0);
    const left = remainingPoints(p, ts);
    // 예산 = 직업이 주는 포인트 + 부정 특성 보상, 사용 = 직업이 먹는 포인트 + 긍정 특성 비용
    const budget = Math.max(0, p.cost) + neg.reduce((s, t) => s - t.cost, 0);
    const spent = Math.max(0, -p.cost) + pos.reduce((s, t) => s + t.cost, 0);

    profBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.prof === profId)));
    traitBtns.forEach((b) => {
      const t = traits.get(b.dataset.trait!)!;
      const on = chosen.has(t.id);
      const why = on ? "" : blocked(t, p);
      b.setAttribute("aria-pressed", String(on));
      b.classList.toggle("is-blocked", !!why);
      b.querySelector<HTMLElement>("[data-why]")!.textContent = why;
    });

    $<HTMLElement>("[data-tab-sub='prof']").textContent = p.name;
    $<HTMLElement>("[data-tab-sub='pos']").textContent = `${pos.length}개`;
    $<HTMLElement>("[data-tab-sub='neg']").textContent = `${neg.length}개`;

    const pts = $<HTMLElement>("[data-points]");
    pts.textContent = String(left);
    pts.classList.toggle("neg", left < 0);
    pts.classList.remove("bump");
    void pts.offsetWidth;
    pts.classList.add("bump");
    $<HTMLElement>("[data-points-mini]").textContent = String(left);
    $<HTMLElement>("[data-points-mini]").classList.toggle("neg", left < 0);
    $<HTMLElement>("[data-sheet-sum]").textContent = `긍정 ${pos.length} · 부정 ${neg.length}`;
    const meter = $<HTMLElement>("[data-meter]");
    meter.style.width = `${budget ? Math.min(100, (spent / budget) * 100) : spent ? 100 : 0}%`;
    meter.classList.toggle("over", left < 0);
    $<HTMLElement>("[data-budget]").textContent = `예산 ${budget} · 사용 ${spent}`;
    $<HTMLElement>("[data-state]").textContent =
      left < 0 ? `${-left}점이 모자랍니다. 긍정 특성을 빼거나 부정 특성을 더하세요` : left === 0 ? "딱 맞습니다. 시작할 수 있습니다" : `${left}점이 남습니다. 시작할 수 있습니다`;

    $<HTMLElement>("[data-s-prof]").textContent = `${p.name} (${fx(p.cost)})`;
    $<HTMLElement>("[data-s-prof-icon]").innerHTML = icon(p.icon, 22);

    for (const [key, list] of [["pos", pos], ["neg", neg]] as const) {
      const ul = $<HTMLElement>(`[data-s-list='${key}']`);
      ul.innerHTML = list.length
        ? list
            .map(
              (t) =>
                `<li>${icon(t.icon)}<span>${esc(t.name)}</span><b class="mono">${fx(-t.cost)}</b><button type="button" data-remove="${t.id}" aria-label="${esc(t.name)} 빼기">×</button></li>`,
            )
            .join("")
        : `<li class="none">없음</li>`;
    }
    const granted = p.granted.map((g) => D.granted[g] ?? g);
    if (granted.length) {
      $<HTMLElement>("[data-s-list='pos']").insertAdjacentHTML("afterbegin", `<li class="granted"><span>직업 특성 · ${esc(granted.join(", "))}</span></li>`);
    }

    const skillsEl = $<HTMLElement>("[data-skills]");
    const skills = skillTotals(p, ts);
    skillsEl.innerHTML = skills.length
      ? skills
          .map(
            (s) =>
              `<li class="${s.level < 0 ? "down" : ""}"><i style="width:${Math.min(100, Math.abs(s.level) * 12)}%"></i><span>${esc(s.name)}</span><b class="mono">${s.level > 0 ? "+" : ""}${s.level}</b></li>`,
          )
          .join("")
      : `<li class="none">없음</li>`;

    const xp = p.xp.map((x: any) => `${x.name} +${x.level}`).join(" · ");
    $<HTMLElement>("[data-prof-detail]").innerHTML =
      `<b>${esc(p.name)}</b> ${xp ? esc(xp) : "기술 보너스 없음"}${granted.length ? ` <span>직업 특성 ${esc(granted.join(", "))}</span>` : ""}`;

    if (touched && conflicts(p, ts).length === 0) history.replaceState(null, "", `#${encodeBuild(profId, [...chosen])}`);
  }

  profBtns.forEach((b) =>
    b.addEventListener("click", () => {
      touched = true;
      profId = b.dataset.prof!;
      const p = profs.get(profId)!;
      for (const id of [...chosen]) {
        const t = traits.get(id)!;
        if (p.granted.includes(id) || p.granted.some((g) => t.exclusive.includes(g))) chosen.delete(id);
      }
      render();
    }),
  );
  traitBtns.forEach((b) =>
    b.addEventListener("click", () => {
      touched = true;
      const id = b.dataset.trait!;
      if (chosen.has(id)) chosen.delete(id);
      else if (!blocked(traits.get(id)!, profs.get(profId)!)) chosen.add(id);
      render();
    }),
  );
  $("[data-summary]").addEventListener("click", (e) => {
    const rm = (e.target as HTMLElement).closest<HTMLElement>("[data-remove]");
    if (!rm) return;
    touched = true;
    chosen.delete(rm.dataset.remove!);
    render();
  });

  function load(profession: string, ids: string[]) {
    if (!profs.has(profession)) return;
    touched = true;
    profId = profession;
    chosen = new Set(ids.filter((id) => traits.has(id)));
    render();
  }

  // ── 찾기·추천만·정렬 ──
  function applyFilters(panel: string) {
    const q = $<HTMLInputElement>(`[data-search='${panel}']`).value.trim().toLowerCase();
    const onlyGood = $<HTMLButtonElement>(`[data-only-good='${panel}']`).getAttribute("aria-pressed") === "true";
    let shown = 0;
    $$<HTMLElement>(`[data-list='${panel}'] [data-trait]`).forEach((b) => {
      const hit = (!q || b.dataset.searchText!.includes(q)) && (!onlyGood || b.dataset.tag === "good" || b.getAttribute("aria-pressed") === "true");
      b.hidden = !hit;
      if (hit) shown++;
    });
    $<HTMLElement>(`[data-empty='${panel}']`).hidden = shown > 0;
  }
  $$<HTMLInputElement>("[data-search]").forEach((i) => i.addEventListener("input", () => applyFilters(i.dataset.search!)));
  $$<HTMLButtonElement>("[data-only-good]").forEach((b) =>
    b.addEventListener("click", () => {
      b.setAttribute("aria-pressed", String(b.getAttribute("aria-pressed") !== "true"));
      applyFilters(b.dataset.onlyGood!);
    }),
  );
  $$<HTMLButtonElement>("[data-sort]").forEach((b) =>
    b.addEventListener("click", () => {
      const [panel, key] = b.dataset.sort!.split(":");
      $$<HTMLButtonElement>(`[data-sort^='${panel}:']`).forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      const list = $<HTMLElement>(`[data-list='${panel}']`);
      const items = $$<HTMLElement>("[data-trait]", list);
      items.sort((a, c) => (key === "cost" ? +c.dataset.cost! - +a.dataset.cost! : +a.dataset.rank! - +c.dataset.rank! || +c.dataset.cost! - +a.dataset.cost!));
      items.forEach((it) => list.append(it));
    }),
  );
  // 처음엔 추천순으로 둔다
  $$<HTMLButtonElement>("[data-sort$=':rank']").forEach((b) => b.click());

  // ── 추천 조합 ──
  $$<HTMLButtonElement>("[data-load-build]").forEach((b) =>
    b.addEventListener("click", () => {
      const build = D.builds.find((x: any) => x.id === b.dataset.loadBuild);
      if (!build) return;
      load(build.profession, build.traits);
      showTab("pos");
      $("[data-builder]").scrollIntoView({ behavior: "smooth", block: "start" });
      const s = $<HTMLElement>(".s-card");
      s.classList.remove("flash");
      void s.offsetWidth;
      s.classList.add("flash");
    }),
  );
  const filterBar = $("[data-build-filter]");
  filterBar.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-group]");
    if (!btn) return;
    $$<HTMLButtonElement>("[data-group]", filterBar).forEach((x) => x.setAttribute("aria-selected", String(x === btn)));
    $$<HTMLElement>("[data-build-grid] .build").forEach((c) => {
      c.hidden = btn.dataset.group !== "all" && c.dataset.group !== btn.dataset.group;
      c.classList.add("is-in");
    });
  });

  // ── 휴대폰 요약 시트 ──
  const summary = $<HTMLElement>("[data-summary]");
  const backdrop = $<HTMLElement>("[data-sheet-backdrop]");
  function closeSheet() {
    summary.classList.remove("open");
    document.body.classList.remove("sheet-open");
    backdrop.hidden = true;
  }
  $("[data-sheet-open]").addEventListener("click", () => {
    summary.classList.add("open");
    document.body.classList.add("sheet-open");
    backdrop.hidden = false;
  });
  backdrop.addEventListener("click", closeSheet);
  $("[data-sheet-close]").addEventListener("click", closeSheet);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSheet();
  });

  // ── 링크 복사, 처음부터 ──
  $<HTMLButtonElement>("[data-reset]").addEventListener("click", () => {
    load("unemployed", []);
    showTab("prof");
  });
  $<HTMLButtonElement>("[data-share]").addEventListener("click", async () => {
    const label = $<HTMLElement>("[data-share-label]");
    try {
      await navigator.clipboard.writeText(location.href);
      label.textContent = "복사됨";
    } catch {
      label.textContent = "주소창의 링크를 복사하세요";
    }
    setTimeout(() => (label.textContent = "링크 복사"), 1800);
  });

  const fromHash = decodeBuild(location.hash);
  if (fromHash) {
    load(fromHash.professionId, fromHash.traitIds);
    showTab("pos");
  } else render();
</script>

