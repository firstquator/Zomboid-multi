---
import MockWindow from "./MockWindow.astro";
import Ring from "./Ring.astro";
import Icon from "../Icon.astro";
import { mods } from "../../lib/site.mjs";

// 처음 접속하면 뜨는 "서버에 적용된 창작마당 아이템" 화면. 모드 이름은 실제 모드팩에서 가져온다.
// 화면 이름과 버튼 이름(설치 / 끊기)은 42.21 한국어 번역 그대로다.
const shown = mods.slice(0, 6);
---

<MockWindow title="Project Zomboid" variant="pz" icon="cloud-download">
  <div class="ws">
    <p class="h">서버에 적용된 창작마당 아이템</p>
    <ul>
      {
        shown.map((m, i) => (
          <li style={`--d:${i * 0.35}s`}>
            <span class="n">{m.name}</span>
            <span class="st">
              <span class="a">미구독</span>
              <span class="b">설치 완료</span>
            </span>
          </li>
        ))
      }
      <li class="more mono">+ {mods.length - shown.length}개</li>
    </ul>
    <div class="btns">
      <span class="btn">끊기</span>
      <span class="btn primary">
        <Icon name="download-04" size={14} />
        설치
        <Ring note="설치" at="top" />
      </span>
    </div>
  </div>
</MockWindow>

<style>
  .ws {
    padding: 22px 24px 24px;
    font-size: 13px;
  }
  .h {
    margin-bottom: 14px;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
  }
  ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid #3a3a32;
    background: rgb(0 0 0 / 0.35);
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 12px;
    border-bottom: 1px solid #2c2c26;
  }
  .n {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #c9c2ad;
    font-family: var(--f-mono);
    font-size: 12px;
  }
  .st {
    position: relative;
    flex: none;
    width: 64px;
    text-align: right;
    font-size: 12px;
  }
  .st span {
    position: absolute;
    right: 0;
    white-space: nowrap;
  }
  .a {
    color: #d98a4a;
  }
  .b {
    color: #8fd18a;
    opacity: 0;
  }
  /* 슬라이드가 보이면 위에서부터 차례로 "설치 완료" 로 바뀐다. */
  :global(.slide.is-active) .a {
    animation: st-out 300ms forwards;
    animation-delay: calc(1.6s + var(--d));
  }
  :global(.slide.is-active) .b {
    animation: st-in 300ms forwards;
    animation-delay: calc(1.6s + var(--d));
  }
  @keyframes st-out {
    to {
      opacity: 0;
    }
  }
  @keyframes st-in {
    to {
      opacity: 1;
    }
  }
  .more {
    justify-content: flex-start;
    color: #8e8a7e;
    font-size: 11.5px;
    border-bottom: 0;
  }
  .btns {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 34px;
  }
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 18px;
    border: 1px solid #4a4a40;
    background: #24241f;
    color: #e8e2d0;
  }
  .btn.primary {
    border-color: #f0a93a;
    color: #f0a93a;
  }
</style>
