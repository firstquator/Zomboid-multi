---
import Icon from "./Icon.astro";
import Topo from "./Topo.astro";
import Skyline from "./Skyline.astro";
import { base } from "../lib/base-url.mjs";
import { site, SERVER_NAME } from "../lib/site.mjs";

// 오른쪽 서버 정보 카드. 접속 전에 알아야 할 사실만 적는다.
const spec = [
  { icon: "game-controller-03", k: "게임 버전", v: `Build ${site.build}`, note: "Steam 베타 설정 '없음'" },
  { icon: "package", k: "모드", v: `${site.modCount}개`, note: `한국어 지원 ${site.koreanCount}개 · 접속 시 자동 설치` },
  { icon: "server-stack-01", k: "호스팅", v: "친구 PC", note: "게임 메뉴의 서버 만들기" },
  { icon: "user-add-01", k: "접속 방식", v: "Steam 초대", note: "포트포워딩·IP 입력 불필요" },
  { icon: "command-line", k: "서버 설정", v: SERVER_NAME, note: "PowerShell 명령 한 줄로 설치" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="sky" aria-hidden="true">
    <div class="moon"></div>
    <div class="stars"></div>
    <Topo seed={42} hills={4} levels={11} drift class="hero-topo" />
    <div class="grain"></div>
  </div>

  <div class="wrap layout">
    <div class="copy">
      <p class="eyebrow">
        <span>Project Zomboid</span>
        <span class="sep" aria-hidden="true"></span>
        <span class="mono">Build {site.build}</span>
        <span class="sep" aria-hidden="true"></span>
        <span>멀티플레이</span>
      </p>

      <h1 id="hero-title" class="display">
        <span class="line l1">좀보이드 멀티</span>
        <span class="line l2">서버 안내</span>
      </h1>

      <p class="lede">
        호스트 1명이 자기 PC 에서 서버를 열고 Steam 으로 초대하면, 나머지는 수락만 하면 됩니다.
        모드 <strong>{site.modCount}개</strong>는 접속할 때 자동으로 설치됩니다.
      </p>

      <div class="ctas">
        <a class="btn btn-red" href={base("host/")}>
          <Icon name="server-stack-01" size={20} />
          <span>호스트 가이드</span>
          <Icon name="arrow-right-02" size={20} />
        </a>
        <a class="btn hero-ghost" href={base("join/")}>
          <Icon name="user-group" size={20} />
          <span>참가자 가이드</span>
          <Icon name="arrow-right-02" size={20} />
        </a>
      </div>
    </div>

    <aside class="spec" aria-label="서버 정보">
      <p class="spec-title">
        <Icon name="information-circle" size={16} />
        <span>서버 정보</span>
        <span class="spec-date mono">{site.checkedAt} 기준</span>
      </p>
      <dl>
        {
          spec.map((s, i) => (
            <div class="row" style={`--i:${i}`}>
              <dt>
                <Icon name={s.icon} size={18} />
                {s.k}
              </dt>
              <dd>
                <span class="v">{s.v}</span>
                <span class="n">{s.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>

  <Skyline />
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(860px, calc(100dvh - 66px));
    padding-bottom: clamp(170px, 17vw, 250px);
    background:
      radial-gradient(60% 40% at 50% 100%, rgb(240 169 58 / 0.2), transparent 70%),
      linear-gradient(180deg, #080a08 0%, #10130f 45%, #1d1d15 78%, #2b2416 100%);
    color: var(--night-ink);
  }
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero :global(.hero-topo) {
    color: var(--sodium);
    opacity: 0.08;
  }
  .moon {
    position: absolute;
    top: 3%;
    right: 24%;
    width: clamp(56px, 6vw, 88px);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 36% 34%, rgb(0 0 0 / 0.08) 0 9%, transparent 10%),
      radial-gradient(circle at 62% 60%, rgb(0 0 0 / 0.07) 0 13%, transparent 14%),
      radial-gradient(circle at 40% 40%, #f7efd6, #d9cfae 70%);
    box-shadow:
      0 0 60px 12px rgb(247 239 214 / 0.1),
      0 0 180px 60px rgb(247 239 214 / 0.05);
    opacity: 0.85;
  }
  .stars {
    position: absolute;
    inset: 0 0 40% 0;
    background-image:
      radial-gradient(1.2px 1.2px at 12% 18%, #fff8 50%, transparent),
      radial-gradient(1px 1px at 28% 8%, #fff6 50%, transparent),
      radial-gradient(1.4px 1.4px at 44% 22%, #fff7 50%, transparent),
      radial-gradient(1px 1px at 63% 12%, #fff5 50%, transparent),
      radial-gradient(1.2px 1.2px at 78% 30%, #fff6 50%, transparent),
      radial-gradient(1px 1px at 92% 6%, #fff5 50%, transparent),
      radial-gradient(1px 1px at 6% 38%, #fff4 50%, transparent),
      radial-gradient(1.3px 1.3px at 54% 40%, #fff4 50%, transparent);
    animation: twinkle 6s ease-in-out infinite alternate;
  }
  @keyframes twinkle {
    to {
      opacity: 0.45;
    }
  }
  .grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='s'><feTurbulence type='fractalNoise' baseFrequency='1.1' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23s)'/></svg>");
    opacity: 0.05;
    mix-blend-mode: screen;
  }

  .layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding-top: clamp(40px, 6vw, 88px);
  }

  .eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    color: var(--sodium);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    animation: rise 700ms 80ms both cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .eyebrow .sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  h1 {
    font-size: clamp(48px, 7vw, 100px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: #f4ecd5;
  }
  .line {
    display: block;
    animation: rise 900ms both cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .l1 {
    animation-delay: 180ms;
  }
  .l2 {
    animation-delay: 300ms;
    color: var(--night-dim);
  }

  .lede {
    max-width: 32em;
    margin-top: 24px;
    font-size: clamp(16px, 1.45vw, 19px);
    color: #cfc6ad;
    animation: rise 900ms 420ms both cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .lede strong {
    color: var(--sodium);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
    animation: rise 900ms 540ms both cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ctas .btn {
    min-height: 56px;
    padding-inline: 22px;
    font-size: 17px;
  }
  .ctas .btn-red {
    --btn-shadow: #000;
    border-color: #000;
  }
  .hero-ghost {
    --btn-bg: rgb(235 226 200 / 0.06);
    --btn-fg: var(--night-ink);
    --btn-shadow: rgb(240 169 58 / 0.5);
    border-color: rgb(235 226 200 / 0.45);
    backdrop-filter: blur(4px);
  }
  .hero-ghost:hover {
    --btn-bg: rgb(235 226 200 / 0.12);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  /* 서버 정보 카드 */
  .spec {
    position: relative;
    padding: 22px 24px 10px;
    border: 1px solid rgb(235 226 200 / 0.14);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015)),
      rgb(14 15 11 / 0.55);
    backdrop-filter: blur(10px);
    box-shadow:
      0 40px 80px -40px rgb(0 0 0 / 0.9),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    animation: rise 900ms 360ms both cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* 카드 위를 한 번 훑고 지나가는 빛줄기. 정보가 갓 갱신된 느낌만 준다. */
  .spec::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(100deg, transparent 30%, rgb(240 169 58 / 0.12) 50%, transparent 70%);
    background-size: 250% 100%;
    background-position: 120% 0;
    animation: sweep 1600ms 900ms ease-out both;
    pointer-events: none;
  }
  @keyframes sweep {
    to {
      background-position: -60% 0;
    }
  }
  .spec-title {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgb(235 226 200 / 0.12);
    color: var(--night-ink);
    font-size: 14px;
    font-weight: 700;
  }
  .spec-title :global(.icon) {
    color: var(--sodium);
  }
  .spec-date {
    margin-left: auto;
    font-size: 11.5px;
    font-weight: 400;
    color: var(--night-dim);
  }
  dl {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 14px;
    padding: 13px 0;
    border-bottom: 1px dashed rgb(235 226 200 / 0.1);
    animation: rise 600ms both cubic-bezier(0.2, 0.7, 0.2, 1);
    animation-delay: calc(560ms + var(--i) * 90ms);
  }
  .row:last-child {
    border-bottom: 0;
  }
  dt {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--night-dim);
    font-size: 13.5px;
  }
  dt :global(.icon) {
    color: var(--sodium);
    opacity: 0.85;
  }
  dd {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .v {
    color: #f4ecd5;
    font-size: 16px;
    font-weight: 700;
  }
  .n {
    color: var(--night-dim);
    font-size: 12.5px;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    /* 한 줄로 쌓이면 달이 맨 위 문구와 겹친다. */
    .moon {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .ctas .btn {
      width: 100%;
      justify-content: space-between;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
