<script>
  // 탭 묶음: 버튼을 누르면 같은 이름의 패널만 보인다.
  function tabs(rootSel: string, tabAttr: string, panelAttr: string) {
    document.querySelectorAll<HTMLElement>(rootSel).forEach((root) => {
      const btns = Array.from(root.querySelectorAll<HTMLButtonElement>(`[${tabAttr}]`));
      btns.forEach((b) =>
        b.addEventListener("click", () => {
          btns.forEach((x) => x.setAttribute("aria-selected", String(x === b)));
          root.querySelectorAll<HTMLElement>(`[${panelAttr}]`).forEach((p) => (p.hidden = p.getAttribute(panelAttr) !== b.getAttribute(tabAttr)));
        }),
      );
    });
  }
  tabs("[data-kg]", "data-kg-tab", "data-kg-panel");
  tabs("[data-topics]", "data-tp-tab", "data-tp-panel");

  // ── 큰 탭과 작은 탭 ──
  // 주소: #keys, #car-fuel 처럼 "큰 탭" 또는 "큰 탭-작은 탭". 뒤로 가기로 탭을 되돌릴 수 있게 pushState 를 쓴다.
  const mainBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
  const tabbar = document.querySelector<HTMLElement>(".tabbar")!;

  function showSub(panel: HTMLElement, subId?: string) {
    const btns = Array.from(panel.querySelectorAll<HTMLButtonElement>(".subtabs [data-sub]"));
    if (!btns.length) return;
    const pick = btns.find((b) => b.dataset.sub === subId) ?? btns.find((b) => b.getAttribute("aria-selected") === "true") ?? btns[0];
    btns.forEach((b) => b.setAttribute("aria-selected", String(b === pick)));
    panel.querySelectorAll<HTMLElement>("[data-subpanel]").forEach((p) => (p.hidden = p.dataset.subpanel !== pick.dataset.sub));
    return pick.dataset.sub;
  }

  function show(hash: string, push = false, scroll = false) {
    const [main, ...rest] = hash.replace(/^#/, "").split("-");
    const id = mainBtns.some((b) => b.dataset.tab === main) ? main : mainBtns[0].dataset.tab!;
    mainBtns.forEach((b) => b.setAttribute("aria-selected", String(b.dataset.tab === id)));
    let shown = id;
    panels.forEach((p) => {
      p.hidden = p.dataset.panel !== id;
      if (!p.hidden) shown = showSub(p, rest.length ? `${id}-${rest.join("-")}` : undefined) ?? id;
    });
    const next = `#${shown}`;
    if (location.hash !== next) history[push ? "pushState" : "replaceState"](null, "", next);
    // 탭을 바꾸면 탭 줄 바로 아래부터 보이게 올린다(페이지 머리 아래로 멀리 내려가 있을 때만).
    if (scroll && tabbar.getBoundingClientRect().top < 0) tabbar.scrollIntoView({ block: "start" });
  }

  mainBtns.forEach((b) => b.addEventListener("click", () => show(`#${b.dataset.tab}`, true)));
  document.querySelectorAll<HTMLButtonElement>(".subtabs [data-sub]").forEach((b) => b.addEventListener("click", () => show(`#${b.dataset.sub}`, true, true)));
  // 작은 탭 끝의 "다음" 버튼
  document.querySelectorAll<HTMLButtonElement>("[data-go-sub]").forEach((b) => b.addEventListener("click", () => show(`#${b.dataset.goSub}`, true, true)));
  window.addEventListener("popstate", () => show(location.hash));
  window.addEventListener("hashchange", () => show(location.hash));
  show(location.hash);
</script>

