---
import MockWindow from "./MockWindow.astro";
import Ring from "./Ring.astro";
import Icon from "../Icon.astro";
// Steam 라이브러리 > 게임 우클릭 > 속성 > 게임 버전 및 베타 화면.
// 베타 이름(unstable, legacy41, 42.19)은 공식 출시 공지 기준이다.
const tabs = ["일반", "업데이트", "설치된 파일", "게임 버전 및 베타", "컨트롤러", "개인정보"];
---

<MockWindow title="Project Zomboid — 속성" variant="steam" icon="game-controller-03">
  <div class="wrap">
    <ul class="side">
      {tabs.map((t) => <li class={t === "게임 버전 및 베타" ? "on" : ""}>{t}</li>)}
    </ul>
    <div class="main">
      <p class="h">게임 버전 및 베타</p>
      <p class="lbl">베타 참여</p>
      <div class="select-wrap">
        <div class="select">
          <span>없음</span>
          <Icon name="arrow-down-01" size={14} />
        </div>
        <Ring note="없음" at="bottom" />
      </div>
      <ul class="opts" aria-hidden="true">
        <li class="sel">없음</li>
        <li class="strike">unstable · 개발 중 빌드</li>
        <li class="strike">legacy41 · Build 41</li>
        <li class="strike">42.19 · 이전 세이브용</li>
      </ul>
    </div>
  </div>
</MockWindow>

<style>
  .wrap {
    display: grid;
    grid-template-columns: 150px 1fr;
    min-height: 300px;
  }
  .side {
    margin: 0;
    padding: 14px 0;
    list-style: none;
    background: rgb(0 0 0 / 0.2);
    font-size: 13px;
  }
  .side li {
    padding: 7px 16px;
    color: #8f98a0;
  }
  .side li.on {
    background: #3d4450;
    color: #fff;
  }
  .main {
    padding: 18px 22px;
  }
  .h {
    margin-bottom: 14px;
    font-size: 18px;
    font-weight: 700;
    color: #fff;
  }
  .lbl {
    margin-bottom: 6px;
    font-size: 12px;
    color: #8f98a0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .select-wrap {
    position: relative;
    width: min(240px, 100%);
  }
  .select {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 12px;
    background: #32353c;
    border-radius: 3px;
    color: #fff;
    font-size: 14px;
  }
  .opts {
    margin: 50px 0 0;
    padding: 6px;
    list-style: none;
    width: min(290px, 100%);
    background: #23262e;
    border-radius: 3px;
    font-size: 12.5px;
    color: #8f98a0;
  }
  .opts li {
    padding: 6px 10px;
  }
  .opts .sel {
    background: #3d6c8d;
    color: #fff;
  }
  .opts .strike {
    text-decoration: line-through;
    text-decoration-color: #e2553f;
  }
</style>
